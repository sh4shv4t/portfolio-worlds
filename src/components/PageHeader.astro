---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  name?: string; // optional view transition name
}
const { eyebrow, title, lede, name } = Astro.props;
---

<header class="page-header container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 transition:name={name}>{title}</h1>
  {lede && <p class="lede muted">{lede}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-top: clamp(48px, 10vw, 96px);
    padding-bottom: 16px;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.2rem);
    margin: 6px 0 16px;
  }
  .lede {
    font-size: 1.15rem;
    max-width: var(--measure);
  }
</style>
