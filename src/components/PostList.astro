---
import type { Post } from '../lib/medium';
import { fmtDate, site } from '../site';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

{
  posts.length ? (
    <ul class="posts">
      {posts.map((p, i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a href={p.link} target="_blank" rel="noopener">
            <span class="eyebrow">{fmtDate(p.date)}</span>
            <span class="title">{p.title}</span>
            <span class="summary muted">{p.summary}</span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="muted reveal">
      Couldn't load posts right now. They're all on{' '}
      <a class="link-arrow" href={site.links.medium}>Medium</a>
    </p>
  )
}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    border-top: 1px solid var(--border);
  }
  a {
    display: grid;
    gap: 4px;
    padding: 20px 0;
    text-decoration: none;
  }
  .title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    transition: color var(--dur-fast);
  }
  a:hover .title {
    color: var(--accent);
  }
  .summary {
    max-width: var(--measure);
    font-size: 0.95rem;
  }
</style>
