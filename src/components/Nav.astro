---
import { site, url } from '../site';

const items = [
  { label: 'Projects', href: '/projects' },
  { label: 'Research', href: '/research' },
  { label: 'Writing', href: '/writing' },
  { label: 'OSS', href: '/oss' },
];
const path = Astro.url.pathname;
---

<header class="nav" transition:animate="none">
  <div class="container inner">
    <a class="brand" href={url('/')}>{site.short}<span class="dot">.</span></a>
    <nav aria-label="Main">
      <ul>
        {
          items.map((i) => (
            <li>
              <a href={url(i.href)} aria-current={path.startsWith(url(i.href)) ? 'page' : undefined}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--border) 60%, transparent);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  .dot {
    color: var(--accent);
  }
  nav {
    margin-left: auto;
    overflow-x: auto;
  }
  ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    position: relative;
    display: block;
    padding: 6px 10px;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--muted);
    transition: color var(--dur-fast);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav a::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .inner {
      gap: 8px;
    }
    ul {
      gap: 0;
    }
    nav a {
      padding: 6px 6px;
      font-size: 0.84rem;
    }
    nav a::after {
      left: 6px;
      right: 6px;
    }
  }
</style>
