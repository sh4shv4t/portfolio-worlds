---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Projects" description="Things Shashvat Singh has built or is building.">
  <PageHeader eyebrow="Projects" title="Things I've built" lede="Some shipped, some still cooking. Click into any of them for the longer story." />
  <div class="container cards">
    {projects.map((p, i) => <ProjectCard project={p} i={i} />)}
  </div>
</Base>

<style>
  .cards {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
