---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ResearchItem from '../components/ResearchItem.astro';

const research = (await getCollection('research', (r) => !r.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Research" description="Research threads Shashvat Singh is working on.">
  <PageHeader eyebrow="Research" title="Questions I'm chasing" lede="Mostly about LLMs: what goes on inside them and why they behave the way they do. Plus the odd systems question I couldn't let go of." />
  <div class="container list">
    {research.map((r, i) => <ResearchItem entry={r} i={i} full />)}
  </div>
</Base>

<style>
  .list {
    margin-top: 24px;
  }
</style>
