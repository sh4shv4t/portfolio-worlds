  <script is:inline>
    (function () {
      var html = document.documentElement;
      var $ = function (s, r) { return (r || document).querySelector(s); };
      var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

      /* ---------- disk LED ---------- */
      var dsk = $('#dsk'), dskT;
      function disk() {
        if (!dsk) return;
        dsk.classList.add('lit');
        clearTimeout(dskT);
        dskT = setTimeout(function () { dsk.classList.remove('lit'); }, 110);
      }

      /* ---------- clock ---------- */
      var clock = $('#clock');
      function tick() {
        var d = new Date(), p = function (n) { return String(n).padStart(2, '0'); };
        clock.textContent = p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
      }
      tick(); setInterval(tick, 1000);

      /* ---------- brightness dial ---------- */
      var levels = [{ g: 0.55, r: -45, n: 'low' }, { g: 1, r: 0, n: 'normal' }, { g: 1.6, r: 50, n: 'high' }], lv = 1;
      var dial = $('#dial'), screen = $('#screen');
      /* ---------- sound (Kenney CC0 UI sounds), off until switched on ---------- */
      var soundOn = false;
      try { soundOn = localStorage.getItem('mf-sound') === '1'; } catch (e) {}
      function sfx(name, vol) {
        if (!soundOn) return;
        var a = new Audio('/assets/sfx/' + name + '.mp3');
        a.volume = vol || 0.3;
        a.play().catch(function () {});
      }
      var sndBtn = $('#snd');
      function paintSnd() {
        sndBtn.style.setProperty('--rot', soundOn ? '45deg' : '-45deg');
        sndBtn.setAttribute('aria-pressed', String(soundOn));
        sndBtn.setAttribute('aria-label', soundOn ? 'Sound on' : 'Sound off');
      }
      paintSnd();
      sndBtn.addEventListener('click', function () {
        soundOn = !soundOn;
        try { localStorage.setItem('mf-sound', soundOn ? '1' : '0'); } catch (e) {}
        paintSnd();
        sfx('toggle', 0.35);
      });

      dial.addEventListener('click', function () {
        sfx('toggle', 0.3);
        lv = (lv + 1) % levels.length;
        screen.style.setProperty('--glow', levels[lv].g);
        dial.style.setProperty('--rot', levels[lv].r + 'deg');
        dial.setAttribute('aria-label', 'Phosphor brightness: ' + levels[lv].n);
        disk();
      });

      /* ---------- panels + selection ---------- */
      var panels = $$('.panel');
      var keys = $$('.fkey');
      var path = $('#path');
      var readouts = $$('.ro');
      var cur = 0;
      var selIdx = panels.map(function () { return 0; });
      var names = ['PROJECTS', 'RESEARCH', 'WRITING', 'OSS'];
      var cmds = ['ls', 'ls', 'cat index', 'git log'];

      function rows(i) { return $$('.row', panels[i == null ? cur : i]); }

      function showReadout(key) {
        readouts.forEach(function (ro) {
          var on = ro.getAttribute('data-for') === key;
          ro.hidden = !on;
          if (on) { ro.classList.remove('drawing'); void ro.offsetWidth; ro.classList.add('drawing'); }
        });
      }

      function select(n, focus) {
        var r = rows();
        if (!r.length) return;
        n = (n + r.length) % r.length;
        var changed = n !== selIdx[cur] || !r[n].classList.contains('sel');
        selIdx[cur] = n;
        r.forEach(function (el, j) { el.classList.toggle('sel', j === n); });
        if (focus) r[n].focus();
        var key = r[n].getAttribute('data-ro');
        if (key && changed) showReadout(key);
        if (changed) { disk(); sfx('nav', 0.22); }
      }

      function show(i, updateHash) {
        cur = i;
        panels.forEach(function (p, j) { p.classList.toggle('on', j === i); });
        keys.forEach(function (k, j) {
          k.classList.toggle('on', j === i);
          if (j === i) k.setAttribute('aria-current', 'true'); else k.removeAttribute('aria-current');
        });
        path.innerHTML = 'SSX:/HOME/' + names[i] + '&gt; <b>' + cmds[i] + '</b>';
        rows().forEach(function (el) { el.classList.remove('sel'); });
        select(selIdx[i]);
        if (updateHash && history.replaceState) history.replaceState(null, '', '#' + panels[i].id);
        disk();
      }

      // The page never scrolls; the tube does. After a section switch make sure the
      // new listing is in view inside the glass (matters on short screens and phones).
      var tube = $('.tube');
      function reveal() {
        var tr = tube.getBoundingClientRect(), pr = path.getBoundingClientRect();
        if (pr.top < tr.top || pr.top > tr.top + tr.height * 0.45) {
          var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          tube.scrollTo({ top: tube.scrollTop + pr.top - tr.top - 10, behavior: reduce ? 'auto' : 'smooth' });
        }
      }

      function press(i) {
        var k = keys[i];
        if (k) { k.classList.add('down'); setTimeout(function () { k.classList.remove('down'); }, 130); }
        sfx('key', 0.35);
        show(i, true);
        reveal();
      }

      keys.forEach(function (k, i) {
        k.addEventListener('click', function (e) {
          e.preventDefault();
          sfx('key', 0.35);
          show(i, true);
          reveal();
        });
      });
      addEventListener('hashchange', function () {
        var id = location.hash.slice(1);
        panels.forEach(function (p, i) { if (p.id === id && i !== cur) show(i, false); });
      });

      panels.forEach(function (p, pi) {
        rows(pi).forEach(function (el, j) {
          el.addEventListener('mouseenter', function () { if (pi === cur) select(j); });
          el.addEventListener('focus', function () { if (pi === cur && selIdx[cur] !== j) select(j); });
        });
      });

      var start = 0;
      var h = (location.hash || '').slice(1);
      panels.forEach(function (p, i) { if (p.id === h) start = i; });
      show(start, false);

      /* ---------- boot sequence ---------- */
      // Every line is scheduled against performance.now() (ms since navigation start),
      // and each frame just paints "where the timeline is now". A throttled or late frame
      // only skips ahead, so the boot is always over by BOOT_END, whatever rAF does.
      var booting = html.classList.contains('booting');
      var over = false, raf = 0, endT = 0, iv = 0;
      var BOOT_END = 2300;

      function onVis() { if (document.hidden) endBoot(); }
      function endBoot() {
        if (over) return;
        over = true;
        cancelAnimationFrame(raf); clearTimeout(endT); clearInterval(iv);
        html.classList.remove('booting');
        html.classList.add('ready');
        booting = false;
        removeEventListener('pointerdown', endBoot, true);
        document.removeEventListener('visibilitychange', onVis);
        // Once the reveal has played, drop the entrance animations so the screen is a
        // plain static paint (a paused or background tab can never get stuck mid power-on).
        if (document.hidden) settle(); else setTimeout(settle, 1000);
      }
      function settle() { html.classList.add('settled'); }
      if (!booting) settle();

      if (booting) {
        var log = $('#boot-log');
        var cursor = document.createElement('span'); cursor.className = 'cur';
        var memory = function (k) { return 'MEMORY CHECK ' + String(Math.round(65536 * k)).padStart(5, ' ') + 'K'; };
        var bar = function (k) {
          var N = 20, f = Math.round(N * k);
          return '[' + '█'.repeat(f) + '░'.repeat(N - f) + '] ' + String(Math.round(k * 100)).padStart(3, ' ') + '%';
        };
        var steps = [
          { t: 180, d: 120, cls: 'hi', text: 'SSX-1 ROM MONITOR V4.02' },
          { t: 320, d: 160, text: '(C) 1986 SINGH SYSTEMS. NO RIGHTS RESERVED.' },
          { t: 520, d: 380, fn: memory, ok: true, noisy: true },
          { t: 940, d: 110, text: 'PHOSPHOR WARMUP ........', ok: true },
          { t: 1080, d: 110, text: 'MOUNTING /HOME/SHASHVAT ..', ok: true },
          { t: 1220, d: 140, cls: 'hi', text: 'LOADING PROFILE: SHASHVAT SINGH' },
          { t: 1380, d: 460, fn: bar, noisy: true },
          { t: 1880, d: 60, cls: 'ok', text: 'READY.', cursor: true }
        ];
        var render = function () {
          if (over) return;
          var now = performance.now();
          for (var i = 0; i < steps.length; i++) {
            var s = steps[i];
            if (now < s.t) break;
            if (!s.el) { s.el = document.createElement('div'); if (s.cls) s.el.className = s.cls; log.appendChild(s.el); }
            if (s.done) continue;
            var k = Math.min(1, (now - s.t) / s.d);
            s.el.textContent = s.fn ? s.fn(k) : s.text.slice(0, Math.ceil(s.text.length * k));
            if (s.noisy && Math.random() < 0.3) disk();
            if (k === 1) {
              s.done = true;
              if (s.ok) { var o = document.createElement('span'); o.className = 'ok'; o.textContent = ' OK'; s.el.appendChild(o); disk(); }
              if (s.cursor) s.el.appendChild(cursor);
            }
          }
          if (now >= BOOT_END) endBoot();
        };
        var frame = function () { render(); if (!over) raf = requestAnimationFrame(frame); };

        if (document.hidden || performance.now() >= BOOT_END) {
          endBoot();
        } else {
          addEventListener('pointerdown', endBoot, true);
          document.addEventListener('visibilitychange', onVis);
          endT = setTimeout(endBoot, Math.max(0, BOOT_END - performance.now()));
          iv = setInterval(render, 100); // keeps painting if rAF gets throttled
          frame();
        }
      }

      /* ---------- keyboard ---------- */
      addEventListener('keydown', function (e) {
        if (booting) { endBoot(); if (e.key !== 'Tab') e.preventDefault(); return; }
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        var t = e.target, k = e.key;
        if (t && t.matches && t.matches('input, textarea, select')) return;
        if (k === 'ArrowDown' || k === 'j') { e.preventDefault(); select(selIdx[cur] + 1, true); }
        else if (k === 'ArrowUp' || k === 'k') { e.preventDefault(); select(selIdx[cur] - 1, true); }
        else if (/^F[1-4]$/.test(k)) { e.preventDefault(); press(+k.charAt(1) - 1); }
        else if (/^[1-4]$/.test(k)) { press(+k - 1); }
        else if (k === 'ArrowRight' || k === 'l') { e.preventDefault(); press((cur + 1) % panels.length); }
        else if (k === 'ArrowLeft' || k === 'h') { e.preventDefault(); press((cur + panels.length - 1) % panels.length); }
        else if (k === 'Enter') {
          if (!(t && t.closest && t.closest('a, button'))) {
            e.preventDefault();
            var r = rows()[selIdx[cur]];
            if (r) r.click();
          }
        }
      });
    })();
  </script>
</body>
</html>
