---
import { url as baseUrl } from '../../site';
// DRAFT: Workbench. An engineering student's bench at 3 AM, rendered as pixel art.
// The scene is authored as one SVG (1920x1080), then rasterised to a 640x360 canvas
// and scaled up with hard pixels. Everything interactive sits in HTML/SVG overlays.

import fs from 'node:fs';
import path from 'node:path';

// Real assets (all CC0), inlined as data URIs so they survive the SVG -> canvas rasterise.
// City art: ansimuz "Warped City". Textures: Poly Haven. Sounds (in /assets/sfx): Kenney.
const asset = (p: string) => {
  const buf = fs.readFileSync(path.join(process.cwd(), 'public/assets', p));
  return `data:image/${p.endsWith('.png') ? 'png' : 'jpeg'};base64,${buf.toString('base64')}`;
};
const A = {
  bench: asset('tex/bench.jpg'),
  ply: asset('tex/plywood.jpg'),
  metal: asset('tex/metal.jpg'),
  sky: asset('city/sky.png'),
  far: asset('city/buildings-far.png'),
  near: asset('city/buildings-near.png'),
  hotel: asset('city/hotel-sign.png'),
};
const PX = 'image-rendering:pixelated';

// Gear outline generator for the mechanical bits
function gear(cx: number, cy: number, r: number, teeth: number, ry = 1) {
  const pts: string[] = [];
  for (let i = 0; i < teeth * 4; i++) {
    const a = (i / (teeth * 4)) * Math.PI * 2;
    const rr = i % 4 < 2 ? r : r * 0.8;
    pts.push(`${(cx + rr * Math.cos(a)).toFixed(1)},${(cy + rr * Math.sin(a) * ry).toFixed(1)}`);
  }
  return pts.join(' ');
}

// Cubbies in the back shelf, left to right (from the sketch)
const cubbies = [
  { x1: 210, x2: 443, href: baseUrl('/projects/project-z'), title: 'Project Z', label: 'PROJECT Z', text: 'A self-hostable platform for agents that get better over time. Run, see, learn.' },
  { x1: 443, x2: 690, href: baseUrl('/projects/errand'), title: 'Errand', label: 'ERRAND', text: 'Send your model on fewer errands. Big models hand off tasks to cheaper specialists.' },
  { x1: 690, x2: 913, href: baseUrl('/projects/tracebank'), title: 'tracebank', label: 'TRACEBANK', text: 'Collects consented, long-horizon coding agent traces, scrubbed on your own machine.' },
  { x1: 913, x2: 1172, href: baseUrl('/research'), title: 'Research', label: 'RESEARCH', text: 'Hidden overrides in reasoning models, why LLMs sound alike and a malloc question.' },
  { x1: 1172, x2: 1346, href: baseUrl('/projects/reminders'), title: 'Reminders', label: 'REMINDERS', text: "A small Windows app so birthdays, events and tasks don't slip through." },
];

// Clickable things on the bench (scene coordinates)
const hotspots = [
  ...cubbies.map((c) => ({ x: c.x1 + 4, y: 304, w: c.x2 - c.x1 - 8, h: 232, href: c.href, title: c.title, text: c.text })),
  { x: 1352, y: 304, w: 360, h: 228, href: baseUrl('/oss'), title: 'Open source & Kaggle', text: 'Merged PRs in Kubeflow and Cortex, plus Name That LLM on Kaggle.' },
  { x: 1296, y: 596, w: 372, h: 244, href: baseUrl('/writing'), title: 'Writing', text: 'Drafts and articles. Mostly on Medium.' },
  { x: 456, y: 600, w: 494, h: 124, href: baseUrl('/projects'), title: 'Everything on the bench', text: 'All the projects, shipped and half-wired.' },
];

const notes = [
  { x: 54, y: 150, w: 330, rot: -4, color: 'yellow', big: true, lines: ["Hey, I'm Shashvat."], sub: 'I build stuff around LLM agents.' },
  { x: 214, y: 772, w: 250, rot: 3, color: 'pink', lines: ['how they run,', 'where they went wrong', '+ how they get better'] },
  { x: 628, y: 786, w: 260, rot: -2, color: 'blue', lines: ['research:', 'poking at the insides', 'of reasoning models'] },
  { x: 1336, y: 846, w: 300, rot: 2, color: 'green', lines: ['OSS: AI infra', 'when I can'], links: true },
];

const inventory = [
  { item: 'Beige CRT', href: baseUrl('/projects/project-z'), title: 'Project Z', text: cubbies[0].text, color: '#4dff88' },
  { item: 'Courier drone', href: baseUrl('/projects/errand'), title: 'Errand', text: cubbies[1].text, color: '#ffb347' },
  { item: 'Tape deck', href: baseUrl('/projects/tracebank'), title: 'tracebank', text: cubbies[2].text, color: '#c9c3b6' },
  { item: 'Oscilloscope', href: baseUrl('/research'), title: 'Research', text: cubbies[3].text, color: '#22e1d6' },
  { item: 'Alarm clock', href: baseUrl('/projects/reminders'), title: 'Reminders', text: cubbies[4].text, color: '#ff4d4d' },
  { item: 'Pegboard', href: baseUrl('/oss'), title: 'Open source & Kaggle', text: 'Merged PRs in Kubeflow and Cortex, plus Name That LLM.', color: '#b06bff' },
  { item: 'Laptop', href: baseUrl('/writing'), title: 'Writing', text: 'Drafts and articles, mostly on Medium.', color: '#8ea4ff' },
];

const holes = Array.from({ length: 26 }, (_, i) => i);
