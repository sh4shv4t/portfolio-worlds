      </footer>
      <p class="credits">
        City pixel art by <a href="https://ansimuz.itch.io/warped-city">ansimuz</a>, textures from
        <a href="https://polyhaven.com">Poly Haven</a>, sounds by <a href="https://kenney.nl">Kenney</a>. All CC0, thank you.
      </p>
    </section>

    <a class="draft-tag" href={baseUrl('/drafts')}>Draft: Workbench</a>

    <script>
      const stage = document.getElementById('stage')!;
      const svg = document.getElementById('scene') as unknown as SVGSVGElement;
      const canvas = document.getElementById('px') as HTMLCanvasElement;
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Rasterise the vector scene into a tiny canvas, then let CSS scale it up with hard pixels.
      function rasterise() {
        const src = new XMLSerializer().serializeToString(svg);
        const img = new Image();
        img.onload = () => {
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.imageSmoothingEnabled = true;
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          // Ordered (Bayer) dither + light colour quantise: gradients band like hand-made pixel art
          try {
            const id = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const d = id.data;
            const B = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
            const step = 14;
            for (let y = 0; y < canvas.height; y++) {
              for (let x = 0; x < canvas.width; x++) {
                const i = (y * canvas.width + x) * 4;
                const t = (B[(y & 3) * 4 + (x & 3)] / 16 - 0.5) * step;
                for (let c = 0; c < 3; c++) d[i + c] = Math.max(0, Math.min(255, Math.round((d[i + c] + t) / step) * step));
              }
            }
            ctx.putImageData(id, 0, 0);
          } catch {
            /* canvas may be locked down in some browsers; plain pixels are fine */
          }
          stage.classList.add('pixel');
        };
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(src);
      }
      rasterise();

      // Sound (Kenney CC0 UI sounds), off until you turn it on
      let soundOn = false;
      try {
        soundOn = localStorage.getItem('wb-sound') === '1';
      } catch {}
      const sfx = (name: string, vol = 0.35) => {
        if (!soundOn) return;
        const a = new Audio(`${import.meta.env.BASE_URL.replace(/[/]$/, "")}/assets/sfx/${name}.mp3`);
        a.volume = vol;
        a.play().catch(() => {});
      };
      const snd = document.getElementById('snd')!;
      const paintSnd = () => {
        snd.textContent = soundOn ? 'SND: ON' : 'SND: OFF';
        snd.setAttribute('aria-pressed', String(soundOn));
      };
      paintSnd();
      snd.addEventListener('click', () => {
        soundOn = !soundOn;
        try {
          localStorage.setItem('wb-sound', soundOn ? '1' : '0');
        } catch {}
        paintSnd();
        sfx('toggle');
      });

      // ---------- Animation layer ----------
      // Everything that moves is drawn here in scene coordinates (1920x1080), onto a canvas that
      // matches the scene's pixel grid, so motion pixelates exactly like the static art.
      const anim = document.getElementById('anim') as HTMLCanvasElement;
      const ac = anim.getContext('2d')!;
      let K = anim.width / 1920;
      const setRes = (hd: boolean) => {
        anim.width = hd ? 1920 : 640;
        anim.height = hd ? 1080 : 360;
        K = anim.width / 1920;
      };
      const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
      const ease = (v: number) => (v < 0.5 ? 2 * v * v : 1 - (-2 * v + 2) ** 2 / 2);
      const phase = (t: number, a: number, b: number) => ease(clamp01((t - a) / (b - a)));
      const mix = (a: number, b: number, k: number) => a + (b - a) * k;
      const box = (x: number, y: number, w: number, h: number, c: string, r = 0) => {
        ac.fillStyle = c;
        if (r) {
          ac.beginPath();
          ac.roundRect(x, y, w, h, r);
          ac.fill();
        } else ac.fillRect(x, y, w, h);
      };
      const dot = (x: number, y: number, r: number, c: string) => {
        ac.fillStyle = c;
        ac.beginPath();
        ac.arc(x, y, r, 0, Math.PI * 2);
        ac.fill();
      };
      const glow = (x: number, y: number, r: number, c: string, a = 0.5) => {
        const g = ac.createRadialGradient(x, y, 0, x, y, r);
        g.addColorStop(0, c);
        g.addColorStop(1, 'transparent');
        ac.globalAlpha = a;
        ac.fillStyle = g;
        ac.fillRect(x - r, y - r, r * 2, r * 2);
        ac.globalAlpha = 1;
      };
      const txt = (s: string, x: number, y: number, size: number, c: string) => {
        ac.fillStyle = c;
        ac.font = `700 ${size}px monospace`;
        ac.fillText(s, x, y);
      };

      // Project Z: agent trace on the CRT. A step travels the chain, the judge flags the bad one.
      const zNodes = [[280, 404], [306, 428], [334, 406], [362, 430], [350, 452], [300, 456]];
      function drawZ(t: number) {
        const p = (t * 0.55) % 1;
        const along = p * (zNodes.length - 1);
        const flagged = along >= 3;
        ac.lineWidth = 2.5;
        ac.strokeStyle = '#1f8c4b';
        ac.beginPath();
        zNodes.forEach(([x, y], i) => (i ? ac.lineTo(x, y) : ac.moveTo(x, y)));
        ac.stroke();
        zNodes.forEach(([x, y], i) => {
          const bad = i === 3 && flagged;
          if (bad) glow(x, y, 16, '#ff3b3b', 0.5 + 0.4 * Math.sin(t * 12));
          dot(x, y, 5, bad ? '#ff4d4d' : i <= along ? '#7dffad' : '#2c8f55');
        });
        const i = Math.min(Math.floor(along), zNodes.length - 2);
        const f = along - i;
        const px = mix(zNodes[i][0], zNodes[i + 1][0], f), py = mix(zNodes[i][1], zNodes[i + 1][1], f);
        glow(px, py, 10, '#d8ffe6', 0.8);
        dot(px, py, 3, '#ffffff');
        if (flagged) txt('!', 368, 420, 14, '#ff4d4d');
        const step = Math.floor(t / 1.1) % 3;
        ['RUN', 'SEE', 'LRN'].forEach((s, k) => {
          box(270 + k * 38, 464, 34, 9, k === step ? '#4dff88' : '#14492a', 2);
          txt(s, 276 + k * 38, 472, 8, k === step ? '#062012' : '#2f8c55');
        });
      }

      // Errand: drone flies to the big robot, takes the parcel, delivers it, parcel goes green.
      const PAD = [628, 494];
      function drawErrand(t: number) {
        const T = t % 6.6;
        let dx = PAD[0], dy = PAD[1], carry = false, done = 0, parcelAlpha = 1;
        const lift = phase(T, 1.0, 1.6), go = phase(T, 1.6, 2.5), down = phase(T, 2.5, 2.9);
        const up = phase(T, 2.9, 3.3), back = phase(T, 3.3, 4.2), land = phase(T, 4.2, 4.8);
        const settle = phase(T, 5.6, 6.0);
        if (T >= 1.0) dy = mix(PAD[1], 420, lift);
        if (T >= 1.6) dx = mix(PAD[0], 548, go);
        if (T >= 2.5) dy = mix(420, 446, down);
        if (T >= 2.9) { dy = mix(446, 412, up); carry = true; }
        if (T >= 3.3) dx = mix(548, PAD[0], back);
        if (T >= 4.2) dy = mix(412, 474, land);
        if (T >= 4.8) done = clamp01((T - 4.8) / 0.4);
        if (T >= 5.6) { carry = false; parcelAlpha = 0; dy = mix(474, PAD[1], settle); }
        const flying = T > 1.0 && T < 6.0;
        // parcel
        const inHand = T < 2.9;
        const fresh = T < 0.5 ? clamp01(T / 0.5) : 1;
        let px = 548, py = 476;
        if (!inHand) { px = dx; py = dy + 30; }
        if (T >= 4.8 && T < 5.6) { px = PAD[0]; py = 504; parcelAlpha = 1 - clamp01((T - 5.2) / 0.4); }
        if (parcelAlpha > 0) {
          ac.globalAlpha = parcelAlpha * fresh;
          box(px - 15, py - 12, 30, 24, done ? '#3bd37a' : '#c0915a', 2);
          box(px - 3, py - 12, 6, 24, done ? '#e9ffe9' : '#e8d9b5');
          if (done) { ac.strokeStyle = '#0b3d1f'; ac.lineWidth = 3; ac.beginPath(); ac.moveTo(px - 8, py); ac.lineTo(px - 2, py + 6); ac.lineTo(px + 9, py - 6); ac.stroke(); }
          ac.globalAlpha = 1;
          if (done && T < 5.6) txt('✓', px - 6, py - 22 - (T - 4.8) * 20, 16, '#4dff88');
        }
        // shadow + drone
        const hgt = clamp01((PAD[1] - dy) / 90);
        ac.globalAlpha = 0.35 * (1 - hgt * 0.6);
        dot(dx, 526, 26 * (1 - hgt * 0.4), '#000');
        ac.globalAlpha = 1;
        const bob = flying ? Math.sin(t * 9) * 1.5 : 0;
        const y = dy + bob;
        if (carry) { ac.strokeStyle = '#1b100a'; ac.lineWidth = 2; ac.beginPath(); ac.moveTo(dx, y + 10); ac.lineTo(dx, y + 18); ac.stroke(); }
        box(dx - 40, y - 12, 80, 5, '#1d1a24', 2);
        const rw = flying ? 16 + Math.abs(Math.sin(t * 40)) * 12 : 26;
        ac.globalAlpha = 0.6;
        ac.fillStyle = '#e9e9ef';
        ac.beginPath(); ac.ellipse(dx - 40, y - 16, rw, 4, 0, 0, Math.PI * 2); ac.ellipse(dx + 40, y - 16, rw, 4, 0, 0, Math.PI * 2); ac.fill();
        ac.globalAlpha = 1;
        ac.fillStyle = '#f2a93b';
        ac.beginPath(); ac.ellipse(dx, y, 30, 11, 0, 0, Math.PI * 2); ac.fill();
        ac.fillStyle = '#ffc96b';
        ac.beginPath(); ac.ellipse(dx, y - 4, 24, 5, 0, 0, Math.PI * 2); ac.fill();
        box(dx - 14, y - 2, 28, 7, '#1b100a', 3);
        box(dx - 9, y, 4, 3, '#22e1d6'); box(dx + 5, y, 4, 3, '#22e1d6');
        // robot antenna blinks while it waits
        dot(494, 382, 5, Math.floor(t * 2) % 2 ? '#ff3d8b' : '#5a1f3a');
        if (T < 1) glow(494, 382, 14, '#ff3d8b', 0.5);
      }

      // tracebank: reels spin, tape moves from left to right, REC blinks, VU meters bounce.
      function drawTape(t: number) {
        const k = (t % 24) / 24;
        const rl = mix(27, 12, k), rr2 = mix(12, 27, k);
        ac.strokeStyle = '#4a3a2c';
        ac.lineWidth = 2;
        ac.beginPath(); ac.moveTo(762 - rl * 0.2, 474 + rl); ac.lineTo(846 + rr2 * 0.2, 474 + rr2); ac.stroke();
        [[762, rl, 3.2], [846, rr2, 2.4]].forEach(([cx, r, sp]) => {
          dot(cx, 474, r, '#5b4130');
          dot(cx, 474, 8, '#c9c3b6');
          ac.strokeStyle = '#2a2420';
          ac.lineWidth = 3;
          for (let i = 0; i < 3; i++) {
            const a = t * sp + (i * Math.PI * 2) / 3;
            ac.beginPath(); ac.moveTo(cx, 474); ac.lineTo(cx + Math.cos(a) * 7, 474 + Math.sin(a) * 7); ac.stroke();
          }
        });
        const rec = Math.floor(t * 1.6) % 2 === 0;
        dot(758, 513, 4, rec ? '#ff3030' : '#4a1010');
        if (rec) glow(758, 513, 12, '#ff3030', 0.6);
        for (let ch = 0; ch < 2; ch++) {
          const lvl = 0.35 + 0.35 * Math.abs(Math.sin(t * (5.3 + ch) + ch)) + 0.25 * Math.abs(Math.sin(t * 13.1 + ch * 2));
          const n = Math.round(lvl * 12);
          for (let i = 0; i < 12; i++) box(778 + i * 9, 507 + ch * 7, 7, 4, i < n ? (i > 9 ? '#ff3030' : i > 7 ? '#f2c230' : '#4dff88') : '#22222a');
        }
      }

      // Research: scope trace with a spike that crosses the threshold and gets bracketed.
      function drawScope(t: number) {
        const x0 = 934, w = 122, cy = 446;
        ac.save();
        ac.beginPath(); ac.rect(x0, 398, w, 94); ac.clip();
        ac.strokeStyle = 'rgba(255,61,90,0.55)';
        ac.setLineDash([4, 4]); ac.lineWidth = 1.5;
        ac.beginPath(); ac.moveTo(x0, 418); ac.lineTo(x0 + w, 418); ac.stroke();
        ac.setLineDash([]);
        const sx = x0 - 20 + ((t * 42) % 170);
        ac.strokeStyle = '#22e1d6'; ac.lineWidth = 2.5; ac.shadowColor = '#22e1d6'; ac.shadowBlur = 6;
        ac.beginPath();
        for (let x = x0; x <= x0 + w; x += 2) {
          const y = cy + Math.sin(x * 0.14 - t * 6) * 6 + Math.sin(x * 0.05 + t) * 3 - 40 * Math.exp(-((x - sx) ** 2) / 22);
          x === x0 ? ac.moveTo(x, y) : ac.lineTo(x, y);
        }
        ac.stroke();
        ac.shadowBlur = 0;
        if (sx > x0 + 6 && sx < x0 + w - 6) {
          ac.strokeStyle = '#ff3d5a'; ac.lineWidth = 2;
          ac.strokeRect(sx - 9, 402, 18, 30);
        }
        ac.restore();
      }

      // Reminders: the phone buzzes with a birthday push every few seconds.
      function drawPhone(t: number) {
        const T = t % 5.5;
        const ring = T < 2.2;
        const shake = T < 0.6 ? Math.sin(T * 90) * 2.5 : 0;
        const x = 1290 + shake, y = 438;
        box(x, y, 40, 80, '#1a1a22', 6);
        box(x + 4, y + 7, 32, 62, ring ? '#1d2448' : '#0b0d14', 3);
        if (ring) {
          glow(x + 20, y + 36, 40, '#8fa8ff', 0.35);
          box(x + 6, y + 18, 28, 20, '#f6eedc', 3);
          box(x + 9, y + 23, 8, 8, '#ff8fc0', 2);
          box(x + 11, y + 20, 4, 3, '#ffd84a');
          box(x + 19, y + 23, 12, 3, '#3a3a48');
          box(x + 19, y + 29, 9, 3, '#8a8aa0');
        }
        box(x + 15, y + 72, 10, 3, '#3a3a48', 1);
      }

      // Bench: LED chase, multimeter + PSU readouts, typing on the laptop, dev board heartbeat.
      function drawBench(t: number) {
        const lit = Math.floor(t * 3) % 3;
        [[534, '#ff3b3b'], [562, '#3bff7a'], [590, '#3b9bff']].forEach(([x, c], i) => {
          if (i === lit) { glow(x as number, 650, 18, c as string, 0.75); dot(x as number, 650, 6, '#ffffff'); }
        });
        if (Math.floor(t * 4) % 4 === 0) { glow(892, 645, 12, '#ff3d8b', 0.7); box(888, 642, 8, 6, '#ffd0e4'); }
        const v = ['3.30', '3.30', '3.29', '3.31'][Math.floor(t * 2.3) % 4];
        txt(v, 1016, 643, 24, '#1c2416');
        txt('12.0', 229, 623, 17, '#ff4040');
        txt(['0.42', '0.43', '0.42', '0.41'][Math.floor(t * 1.7) % 4], 289, 623, 17, '#4dff88');
        // laptop: a draft getting written
        const lines = [150, 220, 200, 210, 0, 190, 214, 120, 0, 180, 160];
        const total = lines.reduce((a, b) => a + b, 0);
        let typed = (t * 70) % (total + 260);
        let y = 640;
        ac.fillStyle = '#e6e6f0';
        for (let i = 0; i < lines.length && typed > 0; i++) {
          const w = Math.min(lines[i], typed);
          if (i === 0) box(1366, y - 8, w, 10, '#e6e6f0');
          else if (lines[i]) box(1366, y - 4, w, 6, '#8a90b8');
          typed -= lines[i];
          if (typed <= 0 && Math.floor(t * 2) % 2) box(1366 + w + 3, y - 8, 3, 12, '#ffffff');
          y += i === 0 ? 20 : 13;
        }
      }

      // Dust in the lamp light, and the odd lamp flicker
      const motes = Array.from({ length: 22 }, (_, i) => [560 + ((i * 197) % 820), (i * 131) % 600, 0.6 + (i % 3) * 0.4]);
      function drawMotes(t: number) {
        motes.forEach(([x0, y0, s], i) => {
          const y = 860 - ((y0 + t * 14 * s) % 600);
          const x = x0 + Math.sin(t * 0.4 + i) * 24 + (860 - y) * 0.25;
          ac.globalAlpha = 0.35 + 0.25 * Math.sin(t + i);
          box(x, y, 5, 5, '#ffe3b8');
        });
        ac.globalAlpha = 1;
        if (t % 7.3 < 0.12) { ac.fillStyle = 'rgba(10,0,20,0.14)'; ac.fillRect(0, 0, 1920, 1080); }
      }

      function frame(t: number) {
        ac.setTransform(1, 0, 0, 1, 0, 0);
        ac.clearRect(0, 0, anim.width, anim.height);
        ac.setTransform(K, 0, 0, K, 0, 0);
        drawZ(t);
        drawErrand(t);
        drawTape(t);
        drawScope(t);
        drawPhone(t);
        drawBench(t);
        drawMotes(t);
      }

      let onScreen = true;
      new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(stage);
      if (still) frame(3.6);
      else {
        let last = 0;
        const loop = (ms: number) => {
          if (onScreen && !document.hidden && ms - last > 50) {
            last = ms;
            frame(ms / 1000);
          }
          requestAnimationFrame(loop);
        };
        requestAnimationFrame(loop);
      }

      // Toggle between chunky pixels and the crisp vector original
      const res = document.getElementById('res')!;
      res.addEventListener('click', () => {
        const hd = stage.classList.toggle('hd');
        res.textContent = hd ? 'RES: HD' : 'RES: 360p';
        setRes(hd);
        if (still) frame(3.6);
        sfx('toggle');
      });

      // Film grain, redrawn a few times a second
      const grain = document.getElementById('grain') as HTMLCanvasElement;
      const gctx = grain.getContext('2d');
      const noise = () => {
        if (!gctx) return;
        const g = gctx.createImageData(grain.width, grain.height);
        for (let i = 0; i < g.data.length; i += 4) {
          const v = Math.random() * 255;
          g.data[i] = g.data[i + 1] = g.data[i + 2] = v;
          g.data[i + 3] = 255;
        }
        gctx.putImageData(g, 0, 0);
      };
      noise();
      if (!still) setInterval(noise, 90);

      // 2. Hover: room dims around the target, reticle locks on, tooltip appears.
      const tip = document.getElementById('tip')!;
      const tipTitle = document.getElementById('tip-title')!;
      const tipText = document.getElementById('tip-text')!;
      document.querySelectorAll<SVGAElement>('.hit').forEach((a) => {
        const show = () => {
          const x = +a.dataset.x!, y = +a.dataset.y!, w = +a.dataset.w!, h = +a.dataset.h!;
          stage.style.setProperty('--fx', `${((x + w / 2) / 1920) * 100}%`);
          stage.style.setProperty('--fy', `${((y + h / 2) / 1080) * 100}%`);
          stage.style.setProperty('--fr', `${(Math.max(w, h) / 1920) * 62}%`);
          stage.classList.add('focus');
          tipTitle.textContent = a.dataset.title!;
          tipText.textContent = a.dataset.text!;
          const below = y < 500;
          tip.style.left = `${Math.min(Math.max((x + w / 2) / 1920, 0.14), 0.86) * 100}%`;
          tip.style.top = `${((below ? y + h + 24 : y - 24) / 1080) * 100}%`;
          tip.classList.toggle('above', !below);
          if (!tip.classList.contains('on') || tipTitle.dataset.last !== a.dataset.title) sfx('hover', 0.25);
          tipTitle.dataset.last = a.dataset.title!;
          tip.classList.add('on');
        };
        const hide = () => {
          stage.classList.remove('focus');
          tip.classList.remove('on');
        };
        a.addEventListener('pointerenter', show);
        a.addEventListener('focus', show);
        a.addEventListener('pointerleave', hide);
        a.addEventListener('blur', hide);
      });

      // 3. Click: quick VHS fast-forward before leaving.
      const ff = document.getElementById('ff')!;
      document.addEventListener('click', (e) => {
        const a = (e.target as Element).closest('a');
        if (!a || still || e.metaKey || e.ctrlKey || e.shiftKey || a.target === '_blank') return;
        const href = a.getAttribute('href') || a.getAttribute('xlink:href');
        if (!href || href.startsWith('http')) return;
        e.preventDefault();
        sfx('click', 0.4);
        sfx('ff', 0.3);
        ff.classList.add('on');
        setTimeout(() => (location.href = href), 420);
      });
      window.addEventListener('pageshow', () => ff.classList.remove('on'));

      // 4. Live clock on the alarm clock, VHS timecode in the corner.
      const clock = document.getElementById('clock')!;
      const tc = document.getElementById('tc')!;
      const t0 = performance.now();
      const pad = (n: number) => String(n).padStart(2, '0');
      const tick = () => {
        const d = new Date();
        clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
        const s = Math.floor((performance.now() - t0) / 1000);
        tc.textContent = `SP ${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}`;
      };
      tick();
      setInterval(tick, 1000);
    </script>

    <style>
      :root {
        --night: #0d0718;
        --pink: #ff3d8b;
        --teal: #22e1d6;
        --violet: #b06bff;
        --amber: #ffb35c;
        --paper: #f3eee4;
        --w: min(100vw, 177.78svh);
        --u: calc(var(--w) / 1920);
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--night);
        color: var(--paper);
        font-family: 'Pixelify Sans', system-ui, sans-serif;
        overflow-x: hidden;
      }
      a {
        color: inherit;
      }

      /* ---------- the stage ---------- */
      .stage {
        position: relative;
        width: var(--w);
        aspect-ratio: 16 / 9;
        margin: 0 auto;
        overflow: hidden;
        background: var(--night);
      }
      #anim {
        image-rendering: pixelated;
        pointer-events: none;
      }
      .hd #anim {
        image-rendering: auto;
      }
      #scene,
      #px,
      #anim,
      .hits {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
      }
      #px {
        image-rendering: pixelated;
        opacity: 0;
        /* cheap chromatic aberration */
        filter: drop-shadow(calc(var(--u) * 3) 0 0 rgb(255 0 90 / 0.28)) drop-shadow(calc(var(--u) * -3) 0 0 rgb(0 220 255 / 0.28));
      }
      .pixel #px {
        opacity: 1;
      }
      .pixel #scene {
        visibility: hidden;
      }
      .pixel.hd #px {
        opacity: 0;
      }
      .pixel.hd #scene {
        visibility: visible;
      }

      /* everything placed in scene coordinates */
      .fx > *,
      .labels span,
      .postit {
        position: absolute;
        left: calc(var(--x) / 1920 * 100%);
        top: calc(var(--y) / 1080 * 100%);
      }
      .fx {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .led {
        width: calc(var(--u) * 22);
        height: calc(var(--u) * 22);
        margin: calc(var(--u) * -11) 0 0 calc(var(--u) * -11);
        border-radius: 50%;
        background: radial-gradient(circle, var(--c) 0 30%, transparent 70%);
        animation: blink var(--t) steps(1) infinite;
        mix-blend-mode: screen;
      }
      .smoke,
      .steam {
        width: calc(var(--u) * 12);
        height: calc(var(--u) * 12);
        background: rgb(230 220 255 / 0.5);
        animation: rise 2.6s linear infinite;
      }
      .steam {
        background: rgb(255 255 255 / 0.35);
        animation-duration: 3.4s;
      }
      .s2 {
        animation-delay: -0.9s;
      }
      .s3 {
        animation-delay: -1.7s;
      }
      .crt,
      .scope,
      .clock,
      .neon {
        width: calc(var(--u) * var(--w));
        height: calc(var(--u) * var(--h));
      }
      .crt {
        background: repeating-linear-gradient(transparent 0 calc(var(--u) * 6), rgb(0 0 0 / 0.25) calc(var(--u) * 6) calc(var(--u) * 9));
        animation: flick 0.12s steps(2) infinite;
      }
      .crt::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(transparent, rgb(77 255 136 / 0.18), transparent);
        height: 30%;
        animation: roll 3s linear infinite;
      }
      .scope {
        overflow: hidden;
      }
      .scope path {
        fill: none;
        stroke: var(--teal);
        stroke-width: 3;
        filter: drop-shadow(0 0 3px var(--teal));
        animation: wave 1.6s linear infinite;
      }
      .clock {
        display: grid;
        place-items: center;
        font-family: 'VT323', monospace;
        font-size: calc(var(--u) * 44);
        color: #ff3a3a;
        text-shadow: 0 0 calc(var(--u) * 8) #ff2020;
        letter-spacing: 0.05em;
      }
      .neon {
        border-radius: calc(var(--u) * 40);
        box-shadow: 0 0 calc(var(--u) * 60) calc(var(--u) * 10) rgb(255 61 139 / 0.35);
        animation: neon 5s steps(1) infinite;
      }

      .labels span {
        transform: translate(-50%, 0);
        font-family: 'Silkscreen', monospace;
        font-size: max(8px, calc(var(--u) * 15));
        padding: calc(var(--u) * 2) calc(var(--u) * 8);
        background: #111;
        color: #f2f2f2;
        border-radius: 2px;
        white-space: nowrap;
        box-shadow: 0 calc(var(--u) * 3) 0 rgb(0 0 0 / 0.5);
      }

      /* focus dimmer (the "slow-mo" look) */
      .dim {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: rgb(12 4 28 / 0.6);
        backdrop-filter: saturate(0.4);
        opacity: 0;
        transition: opacity 0.25s;
        -webkit-mask-image: radial-gradient(circle at var(--fx, 50%) var(--fy, 50%), transparent var(--fr, 10%), #000 calc(var(--fr, 10%) + 8%));
        mask-image: radial-gradient(circle at var(--fx, 50%) var(--fy, 50%), transparent var(--fr, 10%), #000 calc(var(--fr, 10%) + 8%));
      }
      .focus .dim {
        opacity: 1;
      }

      .hit {
        cursor: crosshair;
        outline: none;
      }
      .reticle path {
        fill: none;
        stroke: #fff;
        stroke-width: 8;
        filter: drop-shadow(0 0 6px var(--pink));
      }
      .reticle {
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
        transform: scale(1.12);
        transition: opacity 0.15s, transform 0.25s cubic-bezier(0.2, 1.5, 0.4, 1);
      }
      .hit:hover .reticle,
      .hit:focus-visible .reticle {
        opacity: 1;
        transform: scale(1);
        animation: lock 0.9s ease-in-out 0.25s infinite;
      }

      /* post-its */
      .notes {
        position: absolute;
        inset: 0;
        pointer-events: none;
      }
      .postit {
        pointer-events: auto;
        width: calc(var(--u) * var(--w));
        padding: calc(var(--u) * 26) calc(var(--u) * 20) calc(var(--u) * 18);
        transform: rotate(var(--r));
        color: #2a1a10;
        font-size: max(9px, calc(var(--u) * 21));
        line-height: 1.25;
        box-shadow: calc(var(--u) * 6) calc(var(--u) * 8) 0 rgb(0 0 0 / 0.35);
        transition: transform 0.2s;
        animation: stick 0.5s cubic-bezier(0.2, 1.6, 0.4, 1) both;
      }
      .postit:hover {
        transform: rotate(0deg) translateY(calc(var(--u) * -6));
      }
      .postit p {
        margin: 0;
      }
      .postit h1 {
        font-family: 'Pixelify Sans', sans-serif;
        font-weight: 700;
        font-size: max(14px, calc(var(--u) * 44));
        line-height: 1;
        margin: 0 0 calc(var(--u) * 10);
      }
      .postit .links {
        margin-top: calc(var(--u) * 8);
        font-weight: 700;
      }
      .postit .links a {
        text-decoration: underline;
      }
      .tape {
        position: absolute;
        top: calc(var(--u) * -10);
        left: 50%;
        width: 40%;
        height: calc(var(--u) * 22);
        transform: translateX(-50%) rotate(-3deg);
        background: rgb(255 255 255 / 0.45);
      }
      .yellow {
        background: #ffd84a;
      }
      .pink {
        background: #ff8fc0;
      }
      .blue {
        background: #8fd6ff;
      }
      .green {
        background: #9cf09a;
      }
      .postit:nth-child(2) {
        animation-delay: 0.15s;
      }
      .postit:nth-child(3) {
        animation-delay: 0.3s;
      }
      .postit:nth-child(4) {
        animation-delay: 0.45s;
      }

      /* tooltip, game dialog style */
      .tooltip {
        position: absolute;
        z-index: 6;
        transform: translate(-50%, 0) scale(0.96);
        width: max-content;
        max-width: min(340px, 40%);
        display: grid;
        gap: 4px;
        padding: 10px 14px;
        background: #0b0614;
        border: 3px solid #fff;
        box-shadow: 0 0 0 3px #0b0614, 6px 6px 0 3px rgb(255 61 139 / 0.6);
        font-family: 'VT323', monospace;
        font-size: 1.15rem;
        line-height: 1.15;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.12s, transform 0.12s;
      }
      .tooltip.above {
        transform: translate(-50%, -100%) scale(0.96);
      }
      .tooltip.on {
        opacity: 1;
        transform: translate(-50%, 0) scale(1);
      }
      .tooltip.above.on {
        transform: translate(-50%, -100%) scale(1);
      }
      .t-key {
        color: var(--teal);
        font-size: 0.95rem;
      }
      .tooltip strong {
        font-size: 1.6rem;
        font-weight: 400;
        color: #fff;
        text-shadow: 2px 0 rgb(255 0 90 / 0.7), -2px 0 rgb(0 220 255 / 0.7);
      }

      /* VHS OSD + menu */
      .osd {
        position: absolute;
        top: 2.4%;
        left: 2%;
        display: grid;
        font-family: 'VT323', monospace;
        font-size: max(14px, calc(var(--u) * 40));
        line-height: 1;
        color: #fff;
        text-shadow: 2px 2px 0 #000;
        pointer-events: none;
      }
      .play {
        animation: blink 2s steps(1) infinite;
      }
      .menu {
        position: absolute;
        top: 2.4%;
        right: 2%;
        z-index: 5;
        display: flex;
        gap: 4px;
        font-family: 'VT323', monospace;
        font-size: max(14px, calc(var(--u) * 30));
      }
      .menu a,
      .menu button {
        font: inherit;
        color: #fff;
        text-decoration: none;
        padding: 0 10px;
        background: rgb(11 6 20 / 0.7);
        border: 2px solid rgb(255 255 255 / 0.25);
        cursor: pointer;
      }
      .menu a:hover,
      .menu button:hover {
        background: var(--pink);
        border-color: #fff;
      }
      .menu button {
        color: var(--teal);
      }
      #grain {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        image-rendering: pixelated;
        opacity: 0.07;
        mix-blend-mode: overlay;
      }
      .scan {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background:
          repeating-linear-gradient(transparent 0 2px, rgb(0 0 0 / 0.18) 2px 3px),
          radial-gradient(ellipse at center, transparent 60%, rgb(0 0 0 / 0.45));
        mix-blend-mode: multiply;
      }
      .scan::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        height: 3%;
        background: rgb(255 255 255 / 0.05);
        animation: track 7s linear infinite;
      }

      /* fast-forward transition */
      .ff {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: grid;
        place-items: center;
        pointer-events: none;
        opacity: 0;
        background: repeating-linear-gradient(transparent 0 6px, rgb(255 255 255 / 0.12) 6px 8px), rgb(11 6 20 / 0.55);
      }
      .ff span {
        font-family: 'VT323', monospace;
        font-size: calc(var(--u) * 180);
        color: #fff;
        text-shadow: 4px 0 var(--pink), -4px 0 var(--teal);
      }
      .ff.on {
        opacity: 1;
        animation: ff 0.42s steps(6) both;
      }
      .ff.on ~ *,
      .stage:has(.ff.on) #px {
        filter: blur(1px) hue-rotate(20deg);
      }

      /* ---------- below the stage ---------- */
      .inv {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 16px 40px;
      }
      .inv h2 {
        font-family: 'VT323', monospace;
        font-weight: 400;
        font-size: 2.6rem;
        letter-spacing: 0.1em;
        margin: 0 0 18px;
        color: #fff;
        text-shadow: 3px 0 rgb(255 0 90 / 0.6), -3px 0 rgb(0 220 255 / 0.6);
      }
      .inv ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 10px;
      }
      @media (min-width: 760px) {
        .inv ul {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .inv li a {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 12px;
        text-decoration: none;
        background: #160d26;
        border: 3px solid #2d1f45;
        transition: border-color 0.15s, transform 0.15s;
      }
      .inv li a:hover {
        border-color: var(--pink);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--pink);
      }
      .slot {
        flex: none;
        width: 48px;
        height: 48px;
        display: grid;
        place-items: center;
        font-family: 'VT323', monospace;
        font-size: 1.5rem;
        background: #0b0614;
        border: 3px solid var(--c);
        color: var(--c);
        box-shadow: inset 0 0 12px color-mix(in srgb, var(--c) 40%, transparent);
      }
      .meta {
        display: grid;
        gap: 2px;
      }
      .meta em {
        font-style: normal;
        font-family: 'Silkscreen', monospace;
        font-size: 0.72rem;
        color: var(--amber);
      }
      .meta strong {
        font-size: 1.25rem;
      }
      .meta span {
        color: #bfb3d6;
        font-size: 0.95rem;
      }
      .mobile-notes {
        display: none;
      }
      .pn {
        color: #2a1a10;
        padding: 14px 16px;
        margin: 0 0 12px;
        box-shadow: 5px 6px 0 rgb(0 0 0 / 0.4);
      }
      .pn:nth-child(2) {
        transform: rotate(1deg);
      }
      .pn:nth-child(1) {
        transform: rotate(-1deg);
      }
      .inv footer {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 48px;
        font-family: 'VT323', monospace;
        font-size: 1.3rem;
      }

      .credits {
        text-align: center;
        color: #7d7194;
        font-size: 0.85rem;
        margin-top: 18px;
      }
      .draft-tag {
        position: fixed;
        left: 12px;
        bottom: 12px;
        z-index: 30;
        font-family: 'VT323', monospace;
        font-size: 1.1rem;
        padding: 2px 10px;
        background: var(--pink);
        color: #fff;
        text-decoration: none;
        border: 2px solid #fff;
      }

      /* phones: scene stays as the hero image, notes and labels move below */
      @media (max-width: 820px) {
        .notes,
        .labels,
        .tooltip {
          display: none;
        }
        .menu {
          position: static;
        }
        .stage {
          width: 100vw;
        }
        .mobile-notes {
          display: block;
          margin-bottom: 36px;
        }
        .menu {
          position: absolute;
          top: auto;
          bottom: 3%;
          right: 2%;
          flex-wrap: wrap;
          justify-content: flex-end;
        }
      }

      @keyframes blink {
        50% {
          opacity: 0.15;
        }
      }
      @keyframes rise {
        from {
          transform: translate(0, 0);
          opacity: 0.8;
        }
        to {
          transform: translate(calc(var(--u) * 20), calc(var(--u) * -120));
          opacity: 0;
        }
      }
      @keyframes flick {
        50% {
          opacity: 0.85;
        }
      }
      @keyframes roll {
        from {
          transform: translateY(-100%);
        }
        to {
          transform: translateY(340%);
        }
      }
      @keyframes wave {
        to {
          transform: translateX(-60px);
        }
      }
      @keyframes neon {
        0%,
        100% {
          opacity: 1;
        }
        61% {
          opacity: 0.3;
        }
        63% {
          opacity: 1;
        }
        65% {
          opacity: 0.4;
        }
        67% {
          opacity: 1;
        }
      }
      @keyframes lock {
        50% {
          transform: scale(1.03);
        }
      }
      @keyframes stick {
        from {
          opacity: 0;
          transform: rotate(var(--r)) translateY(calc(var(--u) * -30)) scale(1.1);
        }
        to {
          opacity: 1;
          transform: rotate(var(--r));
        }
      }
      @keyframes track {
        from {
          top: -5%;
        }
        to {
          top: 105%;
        }
      }
      @keyframes ff {
        0% {
          clip-path: inset(0 100% 0 0);
        }
        100% {
          clip-path: inset(0 0 0 0);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation: none !important;
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
