      }

      .draft-tag:hover {
        color: var(--verd);
        border-color: var(--verd-2);
      }

      /* ---------- Sigil (shared by altar, plate and cover) ---------- */
      .sigil {
        --sg-gold: var(--gold);
        --sg-gold-2: var(--gold-2);
        --sg-gold-3: var(--gold-3);
        --sg-verd: var(--verd);
        --sg-verd-2: var(--verd-2);
        --sg-blood: var(--blood-2);
        --sg-ground: var(--ink);
        position: relative;
        aspect-ratio: 1;
        pointer-events: none;
      }

      .sigil svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        fill: none;
      }

      .sigil-outer.spin {
        animation: spin 320s linear infinite;
      }

      .sigil-inner.spin {
        animation: spin 220s linear infinite reverse;
      }

      @keyframes spin {
        to { transform: rotate(360deg); }
      }

      .ln-gold {
        stroke: var(--sg-gold-2);
        stroke-width: 1.1;
      }

      .ln-gold.faint {
        opacity: 0.45;
        stroke-width: 0.7;
      }

      .ln-gold.dashed {
        stroke-dasharray: 2 6;
        opacity: 0.7;
      }

      .ln-gold.hept {
        stroke-width: 0.9;
        opacity: 0.7;
      }

      .ln-verd {
        stroke: var(--sg-verd-2);
        stroke-width: 0.9;
        opacity: 0.8;
      }

      .ln-blood {
        stroke: var(--sg-blood);
        stroke-width: 1.4;
        opacity: 0.8;
      }

      .tk {
        stroke: var(--sg-gold-3);
