        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: var(--gold-2);
        text-shadow: 0 1px 0 rgba(0, 0, 0, 0.8);
      }

      .sigil--cover {
        --sg-verd: #b5934f;
        --sg-verd-2: #8a6f38;
        --sg-blood: #c49a52;
        --sg-ground: #24140b;
        width: 78%;
        margin: 4% 0;
        filter: drop-shadow(0 1px 0 rgba(0, 0, 0, 0.85)) drop-shadow(0 -1px 0 rgba(255, 222, 160, 0.18));
      }

      .sigil--cover .traces {
        animation: none;
        opacity: 0.7;
      }

      .cover-title {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35em;
      }

      .cover-pre {
        font-style: italic;
        font-size: 1.05em;
        color: var(--gold-2);
      }

      .cover-name {
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.85em;
        line-height: 1.05;
        letter-spacing: 0.08em;
        color: #d9b86c;
        text-shadow:
          0 1px 0 rgba(0, 0, 0, 0.9),
          0 -1px 0 rgba(255, 230, 170, 0.22),
          0 0 18px rgba(255, 180, 90, 0.18);
      }

      .cover-hint {
        margin: 0;
        font-family: var(--mono);
        font-size: 0.62em;
        letter-spacing: 0.14em;
        color: rgba(201, 166, 91, 0.75);
        animation: breathe 3.2s ease-in-out infinite;
      }

      @keyframes breathe {
        0%, 100% { opacity: 0.45; }
        50% { opacity: 1; }
      }

      .stamp {
        width: 34%;
        fill: none;
        stroke: rgba(0, 0, 0, 0.55);
        stroke-width: 3;
        filter: drop-shadow(0 1px 0 rgba(255, 220, 160, 0.14));
      }

      .stamp .thin {
        stroke-width: 1.2;
      }

      .cover-kicker.back {
        font-size: 0.6em;
        letter-spacing: 0.3em;
      }

      /* ---------- Frontispiece ---------- */
      .frontis .page-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .plate {
        position: relative;
        width: min(100%, 17em);
        aspect-ratio: 1;
        margin: 0;
        overflow: hidden;
        background:
          radial-gradient(circle at 50% 50%, rgba(255, 176, 92, 0.12), transparent 60%),
          radial-gradient(circle at 50% 50%, rgba(122, 26, 31, 0.3), transparent 72%),
          var(--ink-2);
        border: 1px solid var(--po);
        outline: 1px solid rgba(134, 101, 42, 0.5);
        outline-offset: 4px;
        box-shadow:
          inset 0 0 30px rgba(0, 0, 0, 0.9),
          0 3px 10px rgba(60, 35, 10, 0.35);
      }

      .sigil--plate {
        position: absolute;
        inset: -14%;
        opacity: 0.85;
      }

      .kicker {
        margin: 1.4em 0 0;
        font-size: 0.66em;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--pv);
      }

      .howto {
        margin: 1.2em auto 0;
        max-width: 18em;
        font-style: italic;
        font-size: 0.9em;
        color: var(--pi-3);
      }

      /* ---------- Title page ---------- */
      .title-page .page-inner {
        text-align: center;
      }

      .title {
        margin: 0;
        font-family: var(--display);
        font-size: 1em;
        font-weight: 600;
        line-height: 0.95;
        color: var(--pi);
      }

      .title-pre {
        display: block;
        margin-bottom: 0.7em;
        font-family: var(--book);
        font-style: italic;
        font-weight: 400;
        font-size: 1.15em;
        letter-spacing: 0.04em;
        color: var(--pr);
      }

      .title-line {
        display: block;
        font-size: 2.55em;
        letter-spacing: 0.05em;
        background: linear-gradient(180deg, #2b1d10 0%, #4a3216 55%, #86652a 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .flourish {
        width: 11em;
        max-width: 70%;
        margin: 1.1em auto 1em;
      }

      .flourish.small {
        width: 8em;
      }

      .flourish svg {
        display: block;
        width: 100%;
        height: auto;
        fill: none;
        stroke: var(--po);
        stroke-width: 1;
      }

      .flourish .dot {
        fill: var(--pr);
        stroke: none;
      }

      .lede {
        margin: 0 0 0.5em;
        font-style: italic;
        font-size: 1.4em;
        color: var(--pi);
      }

      .bio,
      .reading-text {
        margin: 0;
        text-align: left;
        font-size: 1.05em;
        color: var(--pi-2);
        hyphens: auto;
      }

      /* the illuminated drop cap stays a little dark panel, like the original */
      .initial {
        float: left;
        display: grid;
        place-items: center;
        width: 2.5em;
        height: 2.5em;
        margin: 0.28em 0.6em 0 0;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.15em;
        line-height: 1;
        color: var(--gold);
        background:
          linear-gradient(var(--ink-2), var(--ink-2)) padding-box,
          linear-gradient(135deg, var(--gold), var(--gold-3) 50%, var(--verd-2)) border-box;
        border: 1px solid transparent;
        box-shadow:
          inset 0 0 0 3px var(--ink-2),
          inset 0 0 0 4px rgba(156, 126, 62, 0.45),
          0 2px 6px rgba(60, 35, 10, 0.35);
        position: relative;
      }

      .initial::before,
      .initial::after {
        content: '';
        position: absolute;
        width: 6px;
        height: 6px;
        border: 1px solid var(--verd);
        border-radius: 50%;
        background: var(--ink);
      }

      .initial::before {
        top: -4px;
        right: 8px;
      }

      .initial::after {
        bottom: -4px;
        left: 8px;
      }

      /* ---------- Contents ---------- */
      .contents {
        margin: 0 auto;
        max-width: 22em;
      }

      .contents-head,
      .toc-head {
        margin: 0 0 0.9em;
        text-align: center;
        font-family: var(--display);
        font-size: 1.5em;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--pi);
      }

      .contents-head::after {
        content: '';
        display: block;
        width: 3em;
        height: 1px;
        margin: 0.5em auto 0;
        background: var(--pr);
      }

      .contents ol,
      .toc ol {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .contents li a,
      .toc li a {
        display: flex;
        align-items: baseline;
        gap: 0.55em;
        padding: 0.45em 0;
        text-decoration: none;
        font-family: var(--display);
        font-size: 1em;
        letter-spacing: 0.06em;
        color: var(--pi);
        transition: color 0.25s;
      }

      .contents li a em {
        font-family: var(--book);
        font-size: 0.95em;
        letter-spacing: 0;
        color: var(--pi-3);
      }

      .leader {
        flex: 1;
        min-width: 1em;
        border-bottom: 1px dotted rgba(122, 100, 70, 0.7);
        transform: translateY(-0.25em);
      }

      .pg {
        font-size: 0.85em;
        color: var(--pr);
      }

      .contents li a:hover,
      .contents li a:focus-visible {
        color: var(--pr);
      }

      .contents li a:hover em {
        color: var(--pv);
      }

      .roman {
        width: 2.2em;
        flex: none;
        font-size: 0.8em;
        color: var(--pr);
      }

      .elsewhere {
        margin: 1.6em 0 0;
        text-align: center;
        font-size: 0.75em;
        color: var(--pi-3);
      }

      .elsewhere a,
      .foot-links a {
        color: var(--pv);
        text-decoration: none;
      }

      .elsewhere a:hover,
      .foot-links a:hover {
        text-decoration: underline;
      }

      /* ---------- Chapter openers and section heads ---------- */
      .opener .page-inner,
      .sec-head {
        text-align: center;
      }

      .opener-head {
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .opener-num {
        display: grid;
        place-items: center;
        width: 3.2em;
        height: 3.2em;
        margin-bottom: 1em;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.6em;
        color: var(--gold);
        background:
          linear-gradient(var(--ink-2), var(--ink-2)) padding-box,
          linear-gradient(135deg, var(--gold), var(--gold-3) 50%, var(--verd-2)) border-box;
        border: 1px solid transparent;
        box-shadow:
          inset 0 0 0 4px var(--ink-2),
          inset 0 0 0 5px rgba(156, 126, 62, 0.45),
          0 3px 10px rgba(60, 35, 10, 0.4);
        text-shadow: 0 0 12px rgba(255, 180, 90, 0.3);
      }

      .sec-num {
        display: inline-block;
        font-size: 0.68em;
        letter-spacing: 0.25em;
        color: var(--pv);
        padding: 2px 10px;
        border: 1px solid rgba(29, 100, 87, 0.45);
        border-radius: 1px;
      }

      .opener h2,
      .sec-head h2 {
        margin: 0.5em 0 0.3em;
        font-family: var(--display);
        font-weight: 500;
        font-size: 2em;
        line-height: 1.1;
        letter-spacing: 0.06em;
        color: var(--pi);
      }

      .sec-head h2 {
        font-size: 1.7em;
      }

      .opener h2::before,
      .opener h2::after,
      .sec-head h2::before,
      .sec-head h2::after {
        content: '✶';
        display: inline-block;
        margin: 0 0.45em;
        font-size: 0.4em;
        vertical-align: middle;
        color: var(--pr);
      }

      .sec-sub {
        margin: 0 auto;
        max-width: 19em;
        font-style: italic;
        color: var(--pi-3);
      }

      .sec-head {
        margin-bottom: 1.6em;
      }

      .fan {
        position: relative;
        height: 7.5em;
        width: 10em;
        margin: 2.4em auto 0;
      }

      .fan span {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 3.4em;
        height: 5.4em;
        margin-left: -1.7em;
        border-radius: 4px;
        transform-origin: 50% 120%;
        background: linear-gradient(180deg, rgba(23, 18, 14, 0.7), rgba(14, 11, 9, 0.85)), #0e0b09 var(--leather) center / 200px;
        box-shadow:
          inset 0 0 0 3px #0e0b09,
          inset 0 0 0 4px rgba(201, 166, 91, 0.55),
          0 3px 8px rgba(40, 20, 5, 0.45);
      }

      .fan span:nth-child(1) { transform: rotate(-24deg); }
      .fan span:nth-child(2) { transform: rotate(-8deg); }
      .fan span:nth-child(3) { transform: rotate(8deg); }
      .fan span:nth-child(4) { transform: rotate(24deg); }

      .star {
        display: block;
        width: 7.5em;
        margin: 2.4em auto 0;
        fill: none;
        stroke: var(--pr);
        stroke-width: 1.4;
        opacity: 0.8;
      }

      .star circle {
        stroke: var(--po);
        stroke-width: 1;
      }

      .star .star-in {
        stroke: var(--pv);
      }

      .more {
        text-align: center;
        margin: 1.6em 0 0;
      }

      .more a {
        font-family: var(--display);
        font-size: 0.78em;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--pr);
        text-decoration: none;
        border-bottom: 1px solid rgba(140, 28, 33, 0.4);
        padding-bottom: 2px;
      }

      .more a::after {
        content: ' →';
        font-family: var(--book);
      }

      .more a:hover,
      .more a:focus-visible {
        color: var(--pv);
        border-color: var(--pv);
      }

      /* ---------- Tarot cards (leather, unchanged in spirit) ---------- */
      .card-page .page-inner {
        display: flex;
        justify-content: center;
      }

      .card {
        --rx: 0deg;
        --ry: 0deg;
        --mx: 50%;
        --my: 30%;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        width: min(100%, 300px);
        aspect-ratio: 5 / 8;
        padding: 1.4em 1.1em 1.5em;
        text-align: center;
        text-decoration: none;
        color: var(--vellum-2);
        /* leather texture: Poly Haven "brown_leather" (CC0), darkened under the gradient */
        background:
          radial-gradient(ellipse 90% 60% at 50% 30%, rgba(201, 166, 91, 0.1), transparent 70%),
          linear-gradient(180deg, rgba(23, 18, 14, 0.8), rgba(14, 11, 9, 0.88) 70%, rgba(18, 13, 11, 0.84)),
          #0e0b09 var(--leather) center / 360px;
        border-radius: 6px;
        box-shadow:
          0 1px 0 rgba(255, 230, 180, 0.04) inset,
          0 14px 26px -12px rgba(40, 20, 5, 0.75),
          0 0 0 1px rgba(0, 0, 0, 0.6);
        transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
        transform-style: preserve-3d;
        transition:
          transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
          box-shadow 0.4s;
      }

      .card.tilting {
        transition: transform 0.08s linear, box-shadow 0.4s;
      }

      .card:hover,
      .card:focus-visible {
        box-shadow:
          0 1px 0 rgba(255, 230, 180, 0.05) inset,
          0 20px 34px -14px rgba(40, 20, 5, 0.85),
          0 0 30px -6px rgba(95, 198, 176, 0.35);
        outline: none;
      }

      .card-frame {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        fill: none;
        pointer-events: none;
        overflow: visible;
      }

      .fr-base {
        stroke: var(--gold-3);
        stroke-width: 0.45;
      }

      .fr-base.stub {
        opacity: 0.8;
      }

      .fr-lit {
        stroke: var(--verd);
        stroke-width: 0.6;
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        transition: stroke-dashoffset 1.3s cubic-bezier(0.6, 0, 0.2, 1);
      }

      .fr-lit.stub {
        transition-delay: 0.35s;
        transition-duration: 0.9s;
      }

      .fr-packet {
        stroke: #c9fff2;
        stroke-width: 1;
        stroke-linecap: round;
        stroke-dasharray: 0.03 0.97;
        opacity: 0;
        transition: opacity 0.4s;
        animation: packet 3.2s linear infinite paused;
      }

      @keyframes packet {
        to { stroke-dashoffset: -1; }
      }

      .card:hover .fr-lit,
      .card:focus-visible .fr-lit {
        stroke-dashoffset: 0;
      }

      .card:hover .fr-packet,
      .card:focus-visible .fr-packet {
        opacity: 0.9;
        animation-play-state: running;
      }

      .card:hover .card-frame,
      .card:focus-visible .card-frame {
        filter: drop-shadow(0 0 3px rgba(95, 198, 176, 0.55));
      }

      .card-sheen {
        position: absolute;
        inset: 0;
        border-radius: inherit;
        pointer-events: none;
        background: radial-gradient(circle at var(--mx) var(--my), rgba(255, 214, 150, 0.1), transparent 45%);
        opacity: 0;
        transition: opacity 0.4s;
      }

      .card:hover .card-sheen {
        opacity: 1;
      }

      .numeral {
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.1em;
        letter-spacing: 0.2em;
        color: var(--gold);
        transform: translateZ(20px);
      }

      .numeral::before,
      .numeral::after {
        content: '';
        display: inline-block;
        width: 1em;
        height: 1px;
        margin: 0 0.6em;
        vertical-align: middle;
        background: var(--gold-3);
      }

      .emblem {
        display: block;
        width: 64%;
        margin: auto 0;
        transform: translateZ(36px);
      }

      .emblem svg {
        display: block;
        width: 100%;
        height: auto;
        fill: none;
        stroke: var(--gold);
        stroke-width: 1.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 0.4s;
      }

      .em-halo {
        stroke: var(--gold-3);
        stroke-width: 0.8;
        stroke-dasharray: 1 3;
      }

      .em-thin {
        stroke-width: 1;
        opacity: 0.7;
      }

      .em-acc {
        stroke: var(--verd);
      }

      .em-acc.fill,
      .em-dot {
        fill: var(--verd);
        stroke: none;
      }

      .card:hover .em-acc,
      .card:focus-visible .em-acc {
        filter: drop-shadow(0 0 3px var(--verd));
      }

      .arcana {
        font-family: var(--display);
        font-size: 0.68em;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--blood-ink);
      }

      .card-name {
        margin-top: 0.1em;
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.45em;
        line-height: 1.15;
        letter-spacing: 0.04em;
        color: var(--vellum);
        transform: translateZ(24px);
      }

      .card-meta {
        margin-top: 0.3em;
        font-size: 0.6em;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--vellum-3);
      }

      .status.building {
        color: var(--verd);
      }

      .status.shipped {
        color: var(--gold);
      }

      /* ---------- Readings (facing each card) ---------- */
      .reading .page-inner {
        text-align: center;
      }

      .reading-num {
        margin: 0;
        font-family: var(--display);
        font-size: 0.7em;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: var(--pr);
      }

      .reading-name {
        margin: 0.25em 0 0.15em;
        font-family: var(--display);
        font-weight: 600;
        font-size: 2.3em;
        line-height: 1.05;
        letter-spacing: 0.04em;
        color: var(--pi);
      }

      .reading-meta {
        margin: 0;
        font-size: 0.66em;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pi-3);
      }

      .page .status.building {
        color: var(--pv);
      }

      .page .status.shipped {
        color: var(--po);
      }

      .card .status.building {
        color: var(--verd);
      }

      .card .status.shipped {
        color: var(--gold);
      }

      .reading-text {
        font-size: 1.15em;
        line-height: 1.5;
      }

      .reading-text::after {
        content: '';
        display: block;
        clear: both;
      }

      /* ---------- Codex ---------- */
      .codex {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .entry {
        padding: 0.75em 0 0.85em;
        border-bottom: 1px solid rgba(134, 101, 42, 0.35);
      }

      .entry:first-child {
        border-top: 1px solid rgba(134, 101, 42, 0.35);
      }

      .entry-main {
        display: flex;
        gap: 0.8em;
        align-items: baseline;
        text-decoration: none;
      }

      .entry-num {
        flex: none;
        width: 1.8em;
        font-family: var(--display);
        font-size: 1.3em;
        color: var(--pr);
        text-align: right;
      }

      .entry-body {
        display: flex;
        flex-direction: column;
      }

      .folio {
        font-size: 0.62em;
        letter-spacing: 0.18em;
        color: var(--po);
      }

      .entry-title {
        font-size: 1.2em;
        line-height: 1.22;
        color: var(--pi);
        background: linear-gradient(var(--pv), var(--pv)) 0 100% / 0 1px no-repeat;
        transition: background-size 0.5s, color 0.3s;
      }

      .entry-main:hover .entry-title,
      .entry-main:focus-visible .entry-title {
        color: #000;
        background-size: 100% 1px;
      }

      .marginalia {
        position: relative;
        display: block;
        margin: 0.4em 0 0 3.6em;
        padding: 0.1em 0 0.1em 0.8em;
        border-left: 1px dashed rgba(140, 28, 33, 0.55);
        transform: rotate(-1.2deg);
        font-style: italic;
        font-size: 0.92em;
        line-height: 1.25;
        color: var(--pr);
      }

      .marginalia::before {
        content: '☞';
        position: absolute;
        left: -1.4em;
        top: 0.05em;
        font-style: normal;
        color: var(--pr);
      }

      .status-note {
        display: block;
        margin-bottom: 0.1em;
        font-style: normal;
        font-size: 0.66em;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--pv);
      }

      .note {
        display: block;
      }

      /* ---------- Scrolls ---------- */
      .scrolls {
        display: grid;
        gap: 1.6em;
        margin: 0 1em;
      }

      .scroll {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 0.15em;
        padding: 1.05em 1.2em 0.95em;
        text-decoration: none;
        background:
          linear-gradient(180deg, rgba(122, 76, 28, 0.16), transparent 30%, transparent 70%, rgba(122, 76, 28, 0.2)),
          #ddcba2;
        border-top: 1px solid rgba(134, 101, 42, 0.6);
        border-bottom: 1px solid rgba(134, 101, 42, 0.6);
        box-shadow: 0 4px 10px -6px rgba(60, 35, 10, 0.6);
        transition: transform 0.4s, box-shadow 0.4s;
      }

      .scroll::before,
      .scroll::after {
        content: '';
        position: absolute;
        top: -0.45em;
        bottom: -0.45em;
        width: 0.75em;
        border-radius: 0.4em;
        background: linear-gradient(90deg, #3a2c14, #b08a45 45%, #6a5126 70%, #2a1f0e);
        box-shadow: 0 3px 6px rgba(40, 20, 5, 0.5);
      }

      .scroll::before {
        left: -0.75em;
      }

      .scroll::after {
        right: -0.75em;
      }

      .scroll:hover,
      .scroll:focus-visible {
        transform: translateY(-3px);
        box-shadow: 0 8px 16px -8px rgba(29, 100, 87, 0.55);
      }

      .scroll-title {
        font-family: var(--display);
        font-size: 1.15em;
