          var P = persp();
          var curl = spread ? 1.6 : 1.2;
          var o = { leaf: [], shade: [], castR: [], castL: [] };
          var n = 24;
          for (var i = 0; i <= n; i++) {
            var t = i / n;
            var a = from + (to - from) * ease(t);
            var r = (a * Math.PI) / 180;
            var s = Math.sin(r);
            var c = Math.cos(r);
            o.leaf.push({
              offset: t,
              transform: 'perspective(' + P + 'px) rotateY(' + (-a).toFixed(2) + 'deg) skewY(' + (-curl * s).toFixed(3) + 'deg)',
            });
            o.shade.push({ offset: t, opacity: +(0.85 * s).toFixed(3) });
            o.castR.push({
              offset: t,
              transform: 'translateX(' + (Math.max(c, 0) * 100).toFixed(2) + '%)',
              opacity: +(a <= 90 ? 0.3 + (0.7 * a) / 90 : (180 - a) / 90).toFixed(3),
            });
            o.castL.push({
              offset: t,
              transform: 'translateX(' + (Math.min(c, 0) * 100).toFixed(2) + '%)',
              opacity: +(a <= 90 ? 0 : 1 - (a - 90) / 180).toFixed(3),
            });
          }
          return o;
        }

        function stopLeaf(L, k) {
          if (!L.anims) return;
          clearTimeout(L.timer);
          L.anims.forEach(function (a) {
            a.cancel();
          });
          L.anims = null;
          L.token++;
          setLeaf(L, k, L.target);
          inflight--;
          if (inflight <= 0) {
            inflight = 0;
            seq = 0;
            settledRange();
            book.classList.remove('turning-busy');
          }
        }

        function stopAll() {
          leaves.forEach(function (L, k) {
            stopLeaf(L, k);
          });
        }

        function flip(k, fwd, o) {
          var L = leaves[k];
          if (!L) return;
          stopLeaf(L, k);
          var j = seq++;
          inflight++;
          book.classList.add('turning-busy');
          var f = fwd ? frames(0, 180) : frames(180, 0);
          var opt = { duration: o.dur, delay: o.delay, fill: 'both', easing: 'linear' };
          L.target = fwd;
          L.el.style.zIndex = 1000 - j;
          var a = L.el.animate(f.leaf, opt);
          var list = [a, L.front.shade.animate(f.shade, opt), L.back.shade.animate(f.shade, opt)];
          if (o.cast) {
            var R = leaves[k + 1];
            var Lt = leaves[k - 1];
            if (R) list.push(R.front.cast.animate(f.castR, opt));
            if (spread && Lt) list.push(Lt.back.cast.animate(f.castL, opt));
          }
          L.anims = list;
          // Swap stacking order the moment the page passes the spine.
          L.timer = setTimeout(function () {
            L.el.style.zIndex = 1000 + j;
          }, o.delay + o.dur / 2);
          var token = ++L.token;
          a.onfinish = function () {
            if (token === L.token) stopLeaf(L, k);
          };
        }

        function currentPage() {
          return spread ? (pos === 0 ? 0 : Math.min(2 * pos - 1, last)) : pos;
        }

        function posFromPage(p) {
          return spread ? Math.floor((p + 1) / 2) : p;
        }

        function chapterOf(i) {
          return pages[i] ? pages[i].getAttribute('data-chapter') : '';
        }

        function goToPos(t, o) {
          o = o || {};
          t = Math.max(0, Math.min(maxPos, t));
          if (t === pos) return;
          var a = pos;
          pos = t;
          var fwd = t > a;
          var dist = Math.abs(t - a);
          if (o.instant || reduceMq.matches) {
            stopAll();
            render();
            if (!o.instant) book.animate([{ opacity: 0.35 }, { opacity: 1 }], { duration: 200, easing: 'ease-out' });
          } else {
            for (var k = Math.min(a, t) - 1; k <= Math.max(a, t); k++) {
              if (leaves[k]) leaves[k].el.classList.remove('far');
            }
            if (dist === 1) {
              flip(fwd ? a : t, fwd, { dur: spread ? 950 : 720, delay: 0, cast: true });
            } else {
              // A riffle: several quick turns, slightly staggered.
              var step = Math.min(90, 900 / dist);
              for (var j = 0; j < dist; j++) {
                flip(fwd ? a + j : a - 1 - j, fwd, { dur: spread ? 640 : 520, delay: j * step, cast: false });
              }
            }
          }
          sync(o);
        }

        function next() {
          goToPos(pos + 1, { push: true });
        }

        function prev() {
          goToPos(pos - 1, { push: true });
        }

        function faces() {
          leaves.forEach(function (L) {
            [L.front, L.back].forEach(function (f) {
              f.inert = true;
              f.classList.remove('live');
            });
          });
          var vis = [];
          if (spread) {
            if (pos > 0) vis.push(leaves[pos - 1].back);
            if (pos < leaves.length) vis.push(leaves[pos].front);
          } else {
            vis.push(leaves[pos].front);
          }
          vis.forEach(function (f) {
            f.inert = false;
            f.classList.add('live');
          });
        }

        function sync(o) {
          o = o || {};
          book.classList.toggle('at-start', pos === 0);
          book.classList.toggle('at-end', pos === maxPos);
          faces();
          prevBtn.disabled = pos === 0;
          nextBtn.disabled = pos === maxPos;
          nextBtn.setAttribute('aria-label', pos === 0 ? 'Open the book' : 'Next page');
          prevBtn.setAttribute('aria-label', pos === maxPos && spread ? 'Open the back cover' : 'Previous page');

          var title, nums, said;
          if (pos === 0) {
            title = 'The cover';
            nums = 'closed';
            said = 'The cover. Closed book.';
          } else if (spread && pos === maxPos) {
            title = 'The back cover';
            nums = 'closed';
            said = 'The back cover. Closed book.';
          } else if (spread) {
            var l = 2 * pos - 1;
            var r = 2 * pos;
            title = chapterOf(r) || chapterOf(l);
            nums = l + ' · ' + r + ' of ' + last;
            said = 'Pages ' + l + ' and ' + r + '. ' + chapterOf(l) + ', ' + chapterOf(r) + '.';
          } else {
            title = chapterOf(pos);
            nums = pos === last ? 'closed' : pos + ' of ' + last;
            said = 'Page ' + pos + '. ' + title + '.';
          }
          whereTitle.textContent = title;
          whereNum.textContent = nums;
          announce.textContent = said;

          if (o.push) writeHash(o.forcePush);
        }

        function writeHash(force) {
          var h = '#p' + currentPage();
          if (location.hash === h) return;
          var now = Date.now();
          try {
            if (!force && now - lastPush < 900) history.replaceState(null, '', h);
            else history.pushState(null, '', h);
          } catch (e) {}
          lastPush = now;
        }

        function pageFromHash(h) {
          if (!h) return null;
          var m = /^#p(\d+)$/.exec(h);
          if (m) return Math.min(+m[1], last);
          var key = h.slice(1);
          return Object.prototype.hasOwnProperty.call(aliases, key) ? aliases[key] : null;
        }

        function onHash() {
          var p = pageFromHash(location.hash);
          var t = posFromPage(p == null ? 0 : p);
          if (t !== pos) goToPos(t, {});
        }

        // ---------- Chapter list ----------
        function setToc(open, opener) {
          toc.hidden = !open;
          tocBtns.forEach(function (b) {
            b.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (open) {
            tocOpener = opener || null;
            var first = toc.querySelector('a');
            if (first) first.focus();
          } else if (tocOpener) {
            tocOpener.focus();
            tocOpener = null;
          }
        }

        tocBtns.forEach(function (b) {
          b.addEventListener('click', function () {
            setToc(toc.hidden, b);
          });
        });

        document.addEventListener('pointerdown', function (e) {
          if (toc.hidden) return;
          if (toc.contains(e.target)) return;
          if (tocBtns.some(function (b) { return b.contains(e.target); })) return;
          tocOpener = null;
          setToc(false);
        });

        // In-book links (#p4 and friends) turn pages instead of jumping.
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[href^="#"]');
          if (!a) return;
          var p = pageFromHash(a.getAttribute('href'));
          if (p == null) return;
          e.preventDefault();
          if (!toc.hidden) {
            tocOpener = null;
            setToc(false);
          }
          goToPos(posFromPage(p), { push: true, forcePush: true });
        });

        prevBtn.addEventListener('click', prev);
        nextBtn.addEventListener('click', next);
        book.querySelector('.edge.prev').addEventListener('click', prev);
        book.querySelector('.edge.next').addEventListener('click', next);

        document.addEventListener('keydown', function (e) {
          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
          var k = e.key;
          if (k === 'Escape' && !toc.hidden) {
            setToc(false);
            e.preventDefault();
            return;
          }
          var onBody = document.activeElement === document.body || document.activeElement === book;
          if (k === 'ArrowRight' || k === 'PageDown') next();
          else if (k === 'ArrowLeft' || k === 'PageUp') prev();
          else if (k === 'Home' && !e.shiftKey) goToPos(0, { push: true, forcePush: true });
          else if (k === 'End' && !e.shiftKey) goToPos(maxPos, { push: true, forcePush: true });
          else if ((k === 'Enter' || k === ' ') && onBody && pos === 0) next();
          else return;
          e.preventDefault();
        });

        // Swipe on touch screens.
        var sx = 0;
        var sy = 0;
        var sid = null;
        book.addEventListener('pointerdown', function (e) {
          if (e.pointerType === 'mouse') return;
          sx = e.clientX;
          sy = e.clientY;
          sid = e.pointerId;
        });
        book.addEventListener('pointerup', function (e) {
          if (e.pointerId !== sid) return;
          sid = null;
          var dx = e.clientX - sx;
          var dy = e.clientY - sy;
          if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) {
            if (dx < 0) next();
            else prev();
          }
        });
        book.addEventListener('pointercancel', function () {
          sid = null;
        });

        window.addEventListener('popstate', onHash);
        window.addEventListener('hashchange', onHash);

        function bind(page) {
          stopAll();
          build();
          pos = Math.max(0, Math.min(maxPos, posFromPage(page)));
          book.classList.add('no-anim');
          render();
          sync({});
          setTimeout(function () {
            book.classList.remove('no-anim');
          }, 60);
        }

        var start = pageFromHash(location.hash);
        bind(start == null ? 0 : start);
        root.classList.add('book-ready');

        spreadMq.addEventListener('change', function () {
          bind(currentPage());
        });
      })();
    </script>
  </body>
</html>
