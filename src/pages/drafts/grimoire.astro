          linear-gradient(160deg, rgba(76, 40, 20, 0.5), rgba(24, 12, 7, 0.72));
        color-scheme: dark;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        overflow-x: clip;
        background: var(--ink);
      }

      body {
        margin: 0;
        overflow-x: clip;
        background:
          radial-gradient(ellipse 80% 50% at 50% 0%, rgba(122, 26, 31, 0.16), transparent 70%),
          radial-gradient(ellipse 60% 40% at 50% 100%, rgba(47, 127, 113, 0.08), transparent 70%),
          var(--ink);
        color: var(--vellum-2);
        font-family: var(--book);
        font-size: 1.1rem;
