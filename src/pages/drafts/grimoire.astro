---
// Draft: Grimoire. A cyberdeck crossed with a forbidden spellbook, now bound as an actual book.
// Standalone page on purpose: no shared layout, all styles live here.
// Without JS the pages simply stack. With JS they get bound into leaves you can flip.
import { site, url } from '../../site';

// Polar helper. 0 degrees points straight up.
const P = (r: number, deg: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return `${(r * Math.cos(a)).toFixed(2)},${(r * Math.sin(a)).toFixed(2)}`;
};

// Tiny deterministic RNG so the sigil looks the same on every build.
let seed = 1729;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return seed / 2147483647;
};

// Outer ring of tick marks.
const ticks = Array.from({ length: 144 }, (_, i) => ({
  deg: i * 2.5,
  len: i % 12 === 0 ? 16 : i % 4 === 0 ? 9 : 5,
  major: i % 12 === 0,
}));

// Glyph markers between the ticks and the text ring.
const glyphs = Array.from({ length: 12 }, (_, i) => ({ deg: i * 30 + 15, kind: i % 3 }));

// Circuit traces radiating out of the inner ring, with a bend and a via at the end.
const traces = Array.from({ length: 30 }, (_, i) => {
  const base = i * 12 + (rnd() - 0.5) * 4;
  const r0 = 130;
  const r1 = 142 + rnd() * 24;
  const bend = (rnd() < 0.5 ? -1 : 1) * (3 + rnd() * 5);
  const r2 = r1 + 10;
  const r3 = Math.min(r2 + 10 + rnd() * 40, 206);
  const end = P(r3, base + bend);
  const [vx, vy] = end.split(',');
  return { d: `M${P(r0, base)} L${P(r1, base)} L${P(r2, base + bend)} L${end}`, vx, vy, big: rnd() > 0.7 };
});

// Seven pointed star {7/3}.
const hept = Array.from({ length: 7 }, (_, k) => P(122, ((k * 3) % 7) * (360 / 7)));
const heptPath = `M${hept.join(' L')} Z`;

// Wobbly wax seal outline.
const sealPath =
  'M' +
  Array.from({ length: 40 }, (_, i) => {
    const r = 44 + (rnd() - 0.5) * 5 + (i % 5 === 0 ? 2 : 0);
    return P(r, i * 9);
  }).join(' L') +
  ' Z';

const ringText =
  '01010011 01010011  RUN · SEE · LEARN  ERRAND ✶ TRACEBANK ✶ PROJECT Z ✶ REMINDERS  0x5353  WHERE DID THE AGENT GO WRONG  ✶  ';

// The sigil shows up three times (altar, frontispiece plate, cover), so it is built as a string once.
const sigilOuter = (id: string, spin = true) =>
  `<svg class="sigil-outer${spin ? ' spin' : ''}" viewBox="-300 -300 600 600" aria-hidden="true" focusable="false">` +
  `<circle r="292" class="ln-gold faint"/><circle r="286" class="ln-gold"/>` +
  `<g class="ticks">${ticks
    .map(
      (t) =>
        `<line x1="0" y1="-286" x2="0" y2="${-286 + t.len}" transform="rotate(${t.deg})" class="${t.major ? 'tk-major' : 'tk'}"/>`
    )
    .join('')}</g>` +
  `<circle r="262" class="ln-gold dashed"/>` +
  `<g class="glyphs">${glyphs
    .map((g) => {
      const shape =
        g.kind === 0
          ? '<path d="M0,-6 L6,0 L0,6 L-6,0 Z" class="gl"/>'
          : g.kind === 1
            ? '<circle r="4.5" class="gl"/>'
            : '<path d="M0,-6 L5.5,4 L-5.5,4 Z" class="gl"/>';
      return `<g transform="rotate(${g.deg}) translate(0 -251)">${shape}</g>`;
    })
    .join('')}</g>` +
  `<path id="${id}" d="M0,-226 a226,226 0 1,1 0,452 a226,226 0 1,1 0,-452" fill="none"/>` +
  `<text class="ring-text"><textPath href="#${id}" textLength="1410" lengthAdjust="spacing">${ringText}</textPath></text>` +
  `<circle r="214" class="ln-verd"/></svg>`;

const sigilInner = (spin = true) =>
  `<svg class="sigil-inner${spin ? ' spin' : ''}" viewBox="-300 -300 600 600" aria-hidden="true" focusable="false">` +
  `<g class="traces">${traces
    .map((t) => `<path d="${t.d}"/><circle cx="${t.vx}" cy="${t.vy}" r="${t.big ? 4 : 2.6}"/>`)
    .join('')}</g>` +
  `<circle r="130" class="ln-gold"/><circle r="124" class="ln-gold faint"/>` +
  `<path d="${heptPath}" class="ln-gold hept"/><circle r="72" class="ln-blood"/><circle r="46" class="ln-gold faint"/></svg>`;

const cards = [
  {
    n: 'I',
    arcana: 'The Courier',
    name: 'Errand',
    status: 'building',
    year: '2026',
    href: url('/projects/errand'),
    emblem: 'courier',
    desc: 'Send your model on fewer errands. A marketplace where big models hand off tasks to cheaper specialist models.',
  },
  {
    n: 'II',
    arcana: 'The Archivist',
    name: 'tracebank',
    status: 'building',
    year: '2026',
    href: url('/projects/tracebank'),
    emblem: 'archivist',
    desc: 'A plugin that collects consented, long-horizon coding agent traces, scrubbed on your own machine.',
  },
  {
    n: 'III',
    arcana: 'The Watcher',
    name: 'Project Z',
    status: 'building',
    year: '2026',
    href: url('/projects/project-z'),
    emblem: 'watcher',
    desc: 'A self-hostable platform for agents that get better over time. Run, see, learn.',
  },
  {
    n: 'IV',
    arcana: 'The Herald',
    name: 'Reminders',
    status: 'shipped',
    year: '2026',
    href: url('/projects/reminders'),
    emblem: 'herald',
    desc: "A small Windows app so birthdays, events and tasks don't slip through.",
  },
];

const codex = [
  {
    num: 'i',
    folio: 'f. 01r',
    title: "Overrides the chain of thought doesn't show",
    status: 'in progress',
    note: 'when the reasoning says one thing and the answer quietly does another',
  },
  {
    num: 'ii',
    folio: 'f. 02v',
    title: 'Why do LLMs all sound the same?',
    status: 'early',
    note: 'mode collapse, but for prose and ideas',
  },
  {
    num: 'iii',
    folio: 'f. 03r',
    title: 'What if malloc filled holes from the top?',
    status: 'writing up',
    note: 'top down vs bottom up hole placement, measured',
  },
];

const pacts = [
  { repo: 'kubeflow/pipelines', kind: 'merged PR', sealed: true },
  { repo: 'cortexproject/cortex', kind: 'merged PR', sealed: true },
  { repo: 'kubeflow/website', kind: 'merged PR', sealed: true },
  { repo: 'Kaggle: Name That LLM', kind: 'ongoing', sealed: false },
];

// Card border: clipped corners plus little trace stubs with pads.
const frame = 'M7,2 H93 L98,7 V153 L93,158 H7 L2,153 V7 Z';
const stubs =
  'M50,2 V7 H60 M50,158 V153 H40 M2,44 H7 V58 M98,116 H93 V102 M20,2 V5 H28 M80,158 V155 H72 M2,120 H5 V128 M98,30 H95 V22';

// Page plan. Page 0 is the front cover, the last page is the back cover.
// On desktop each leaf holds two pages (front, back). On phones every page is its own leaf.
// Project cards sit on pages 5, 7, 9, 11 with their readings facing them.
const cardPage = (i: number) => 5 + i * 2;

// Chapters for the contents page and the ribbon.
const chapters = [
  { roman: 'I', name: 'Arcana', em: 'projects', page: 4 },
  { roman: 'II', name: 'Codex', em: 'research', page: 13 },
  { roman: 'III', name: 'Scrolls', em: 'writing', page: 15 },
  { roman: 'IV', name: 'Pacts', em: 'open source', page: 16 },
];

const ribbonList = [
  { label: 'The cover', page: 0 },
  { label: "Hey, I'm Shashvat", page: 2 },
  { label: 'Index', page: 3 },
  { label: 'I · The Arcana', page: 4 },
  { label: 'II · The Codex', page: 13 },
  { label: 'III · The Scrolls', page: 15 },
  { label: 'IV · Pacts Sealed', page: 16 },
  { label: 'Colophon', page: 17 },
  { label: 'The back cover', page: 19 },
];

const leather = url('/assets/tex/leather.jpg');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Grimoire · {site.name}</title>
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0a0807" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body style={`--leather: url('${leather}')`}>
    <!-- Shared SVG defs. Kept rendered (0x0) so gradients work everywhere. -->
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <radialGradient id="g-wax" cx="38%" cy="34%" r="70%">
          <stop offset="0" stop-color="#b8343a" />
          <stop offset=".55" stop-color="#7a1a1f" />
          <stop offset="1" stop-color="#3d0a0d" />
        </radialGradient>
        <linearGradient id="g-gold" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#e3c47e" />
          <stop offset=".5" stop-color="#b38f48" />
          <stop offset="1" stop-color="#6f5628" />
        </linearGradient>
        <symbol id="seal" viewBox="-50 -50 100 100">
          <path d={sealPath} fill="url(#g-wax)" />
          <circle r="31" fill="none" stroke="#3d0a0d" stroke-width="3" opacity=".7" />
          <circle r="31" fill="none" stroke="#d26a6f" stroke-width=".8" opacity=".35" transform="translate(-1 -1)" />
          <path d="M-15,1 L-5,11 L15,-11" fill="none" stroke="#2a0608" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M-15,0 L-5,10 L15,-12" fill="none" stroke="#e08a8e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />
          <circle cx="-15" cy="0" r="3" fill="#2a0608" />
          <circle cx="15" cy="-12" r="3" fill="#2a0608" />
          <ellipse cx="-16" cy="-22" rx="12" ry="5" fill="#fff" opacity=".12" transform="rotate(-30 -16 -22)" />
        </symbol>
        <symbol id="fleuron" viewBox="0 0 40 40">
          <path d="M2,2 H22 M2,2 V22" />
          <path d="M2,2 Q16 6 18,18 Q6 16 2,2 Z" class="fl-leaf" />
          <circle cx="24" cy="2" r="1.6" class="fl-dot" />
          <circle cx="2" cy="24" r="1.6" class="fl-dot" />
          <path d="M7,7 L12,12" />
        </symbol>
      </defs>
    </svg>

    <!-- The desk the book lies on: candle glow, a slow altar sigil, grain. -->
    <div class="desk" aria-hidden="true">
      <div class="candle"></div>
      <div class="sigil sigil--altar">
        <Fragment set:html={sigilOuter('ring-altar') + sigilInner()} />
      </div>
      <div class="grain"></div>
      <div class="taper"><span class="wick"></span><span class="flame"></span></div>
    </div>

    <a class="draft-tag" href={url('/drafts')}>Draft: Grimoire</a>

    <div class="stage" id="stage">
      <div class="book" id="book" aria-label="The codex of Shashvat Singh" role="region">
        <!-- p0 · front cover -->
        <section class="page cover" id="p0" data-chapter="Cover">
          <div class="cover-art">
            <svg class="fleuron tl" aria-hidden="true"><use href="#fleuron" /></svg>
            <svg class="fleuron tr" aria-hidden="true"><use href="#fleuron" /></svg>
            <svg class="fleuron bl" aria-hidden="true"><use href="#fleuron" /></svg>
            <svg class="fleuron br" aria-hidden="true"><use href="#fleuron" /></svg>
            <p class="cover-kicker">Liber machinae</p>
            <div class="sigil sigil--cover" aria-hidden="true">
              <Fragment set:html={sigilOuter('ring-cover', false) + sigilInner(false)} />
            </div>
            <p class="cover-title">
              <span class="cover-pre">The codex of</span>
              <span class="cover-name">Shashvat Singh</span>
            </p>
            <p class="cover-hint js-only">click, tap or press → to open</p>
          </div>
        </section>

        <!-- p1 · frontispiece, pasted inside the front board -->
        <section class="page frontis verso pastedown" id="p1" data-chapter="Frontispiece">
          <div class="page-body">
            <div class="page-inner">
              <figure class="plate" aria-hidden="true">
                <div class="sigil sigil--plate">
                  <Fragment set:html={sigilOuter('ring-plate') + sigilInner()} />
                </div>
              </figure>
              <p class="kicker mono">MS. 2026 · folio i · liber machinae</p>
              <p class="howto js-only">Turn the pages with the arrow keys, the page corners or a swipe.</p>
            </div>
          </div>
        </section>

        <!-- p2 · title page -->
        <section class="page title-page recto" id="p2" data-chapter="Title">
          <div class="page-body">
            <div class="page-inner">
              <h1 class="title">
                <span class="title-pre">The codex of</span>
                <span class="title-line">Shashvat</span>
                <span class="title-line">Singh</span>
              </h1>
              <div class="flourish" aria-hidden="true">
                <svg viewBox="0 0 240 20">
                  <path d="M0,10 H96 M144,10 H240" />
                  <path d="M104,10 L120,2 L136,10 L120,18 Z" />
                  <circle cx="120" cy="10" r="2.5" class="dot" />
                  <circle cx="96" cy="10" r="2" class="dot" />
                  <circle cx="144" cy="10" r="2" class="dot" />
                </svg>
              </div>
              <p class="lede">Hey, I'm Shashvat.</p>
              <p class="bio">
                <span class="initial" aria-hidden="true">I</span><span class="sr">I</span> build stuff around LLM agents: how
                they run, how you figure out where they went wrong and how they get better over time. On the research side I
                poke at the insides of reasoning models, and when I can I contribute to open source AI infra.
              </p>
            </div>
          </div>
          <p class="folio-num" aria-hidden="true">2</p>
        </section>

        <!-- p3 · contents -->
        <section class="page contents-page verso" id="p3" data-chapter="Index">
          <p class="run-head" aria-hidden="true">The codex of Shashvat Singh</p>
          <div class="page-body">
            <div class="page-inner">
              <nav class="contents" aria-label="Contents">
                <p class="contents-head">Index</p>
                <ol>
                  {chapters.map((c) => (
                    <li>
                      <a href={`#p${c.page}`}>
                        <span class="roman">{c.roman}</span>
                        <span class="c-name">{c.name}</span>
                        <em>{c.em}</em>
                        <span class="leader" aria-hidden="true"></span>
                        <span class="pg">{c.page}</span>
                      </a>
                    </li>
                  ))}
                  <li>
                    <a href="#p17">
                      <span class="roman">✶</span>
                      <span class="c-name">Colophon</span>
                      <span class="leader" aria-hidden="true"></span>
                      <span class="pg">17</span>
                    </a>
                  </li>
                </ol>
                <p class="elsewhere mono">
                  <a href={site.links.github} rel="me noopener" target="_blank">github/sh4shv4t</a>
                  <span aria-hidden="true">✶</span>
                  <a href={site.links.medium} rel="me noopener" target="_blank">medium</a>
                </p>
              </nav>
            </div>
          </div>
          <p class="folio-num" aria-hidden="true">3</p>
        </section>

        <!-- p4 · chapter I opener -->
        <section class="page opener recto" id="p4" data-chapter="The Arcana">
          <p class="run-head" aria-hidden="true">Liber primus</p>
          <div class="page-body">
            <div class="page-inner">
              <header class="opener-head" id="arcana">
                <span class="opener-num" aria-hidden="true">I</span>
                <span class="sec-num mono">§ I</span>
                <h2>The Arcana</h2>
                <p class="sec-sub">Projects. What I'm building right now, plus one small thing that shipped.</p>
              </header>
              <div class="fan" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
            </div>
          </div>
          <p class="folio-num" aria-hidden="true">4</p>
        </section>

        <!-- p5 to p12 · one spread per project: the card on the left, the reading on the right -->
        {cards.map((c, i) => (
          <>
            <section class="page card-page verso" id={`p${cardPage(i)}`} data-chapter={`The Arcana · ${c.name}`}>
              <p class="run-head" aria-hidden="true">The Arcana</p>
              <div class="page-body">
                <div class="page-inner">
                  <a class="card" href={c.href}>
                    <svg class="card-frame" viewBox="0 0 100 160" preserveAspectRatio="none" aria-hidden="true">
                      <path d={frame} class="fr-base" />
                      <path d={stubs} class="fr-base stub" />
                      <path d={frame} class="fr-lit" pathLength="1" />
                      <path d={stubs} class="fr-lit stub" pathLength="1" />
                      <path d={frame} class="fr-packet" pathLength="1" />
                    </svg>
                    <span class="card-sheen" aria-hidden="true"></span>

                    <span class="numeral">{c.n}</span>

                    <span class="emblem" aria-hidden="true">
                      <svg viewBox="0 0 80 80">
                        <circle cx="40" cy="40" r="36" class="em-halo" />
                        {c.emblem === 'courier' && (
                          <>
                            <path d="M8,26 Q40 6 72,26" class="em-thin" />
                            <circle cx="24" cy="44" r="14" />
                            <circle cx="24" cy="44" r="5" class="em-acc" />
                            <circle cx="62" cy="44" r="7" />
                            <path d="M39,44 H52" stroke-dasharray="3 3" />
                            <path d="M49,40 L54,44 L49,48" />
                            <path d="M14,62 Q40 74 66,62" class="em-thin" />
                          </>
                        )}
                        {c.emblem === 'archivist' && (
                          <>
                            <rect x="20" y="14" width="40" height="48" rx="2" />
                            <path d="M20,30 H60 M20,46 H60" />
                            <path d="M36,22 H44 M36,38 H44 M36,54 H44" class="em-acc" />
                            <path d="M40,62 V70 H56" class="em-thin" />
                            <circle cx="58" cy="70" r="2.4" class="em-dot" />
                            <path d="M40,62 V70 H24" class="em-thin" />
                            <circle cx="22" cy="70" r="2.4" class="em-dot" />
                          </>
                        )}
                        {c.emblem === 'watcher' && (
                          <>
                            <path d="M10,44 Q40 16 70,44 Q40 72 10,44 Z" />
                            <circle cx="40" cy="44" r="11" />
                            <circle cx="40" cy="44" r="4" class="em-acc fill" />
                            <path d="M40,10 V20 M21,15 L26,23 M59,15 L54,23" class="em-thin" />
                          </>
                        )}
                        {c.emblem === 'herald' && (
                          <>
                            <circle cx="40" cy="18" r="3" />
                            <path d="M27,54 Q27 24 40,22 Q53 24 53,54 Z" />
                            <path d="M22,54 H58" />
                            <circle cx="40" cy="60" r="3" class="em-acc fill" />
                            <path d="M61,30 Q67 38 61,46 M67,25 Q75 38 67,51" class="em-thin" />
                            <path d="M19,30 Q13 38 19,46 M13,25 Q5 38 13,51" class="em-thin" />
                          </>
                        )}
                      </svg>
                    </span>

                    <span class="arcana">{c.arcana}</span>
                    <span class="card-name">{c.name}</span>
                    <span class="card-meta mono">
                      <span class={`status ${c.status}`}>{c.status}</span> · {c.year}
                    </span>
                  </a>
                </div>
              </div>
              <p class="folio-num" aria-hidden="true">{cardPage(i)}</p>
            </section>

            <section class="page reading recto" id={`p${cardPage(i) + 1}`} data-chapter={`The Arcana · ${c.name}`}>
              <p class="run-head" aria-hidden="true">{c.arcana}</p>
              <div class="page-body">
                <div class="page-inner">
                  <p class="reading-num">Arcanum {c.n} · {c.arcana}</p>
                  <h3 class="reading-name">{c.name}</h3>
                  <p class="reading-meta mono">
                    <span class={`status ${c.status}`}>{c.status}</span> · {c.year}
                  </p>
                  <div class="flourish small" aria-hidden="true">
                    <svg viewBox="0 0 240 20">
                      <path d="M0,10 H96 M144,10 H240" />
                      <path d="M104,10 L120,2 L136,10 L120,18 Z" />
                      <circle cx="120" cy="10" r="2.5" class="dot" />
                    </svg>
                  </div>
                  <p class="reading-text">
                    <span class="initial" aria-hidden="true">{c.desc.charAt(0)}</span><span class="sr">{c.desc.charAt(0)}</span>{c.desc.slice(1)}
                  </p>
                  <p class="more"><a href={c.href}>Open the {c.name} page</a></p>
                </div>
              </div>
              <p class="folio-num" aria-hidden="true">{cardPage(i) + 1}</p>
            </section>
          </>
        ))}

        <!-- p13 · chapter II opener -->
        <section class="page opener verso" id="p13" data-chapter="The Codex">
          <p class="run-head" aria-hidden="true">Liber secundus</p>
          <div class="page-body">
            <div class="page-inner">
              <header class="opener-head" id="codex">
                <span class="opener-num" aria-hidden="true">II</span>
                <span class="sec-num mono">§ II</span>
                <h2>The Codex</h2>
                <p class="sec-sub">Research. Open questions I keep poking at.</p>
              </header>
              <svg class="star" viewBox="-130 -130 260 260" aria-hidden="true">
                <circle r="126" />
                <path d={heptPath} />
                <circle r="44" class="star-in" />
              </svg>
            </div>
          </div>
          <p class="folio-num" aria-hidden="true">13</p>
        </section>

        <!-- p14 · codex entries -->
        <section class="page codex-page recto" id="p14" data-chapter="The Codex">
          <p class="run-head" aria-hidden="true">The Codex</p>
          <div class="page-body">
            <div class="page-inner">
              <ol class="codex" role="list">
                {codex.map((e) => (
                  <li class="entry">
                    <a class="entry-main" href={url('/research')}>
                      <span class="entry-num" aria-hidden="true">{e.num}.</span>
                      <span class="entry-body">
                        <span class="folio mono">{e.folio}</span>
                        <span class="entry-title">{e.title}</span>
                      </span>
                    </a>
                    <aside class="marginalia">
                      <span class="mono status-note">{e.status}</span>
                      <span class="note">{e.note}</span>
                    </aside>
                  </li>
                ))}
              </ol>
              <p class="more"><a href={url('/research')}>Open the full codex</a></p>
            </div>
          </div>
          <p class="folio-num" aria-hidden="true">14</p>
        </section>

        <!-- p15 · scrolls -->
