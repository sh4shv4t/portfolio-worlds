      .fleuron.tr { top: 10px; right: 10px; transform: scaleX(-1); }
      .fleuron.bl { bottom: 10px; left: 10px; transform: scaleY(-1); }
      .fleuron.br { bottom: 10px; right: 10px; transform: scale(-1, -1); }

      .cover-kicker {
        margin: 0;
        font-family: var(--display);
