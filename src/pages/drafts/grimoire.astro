        --gold-2: #9c7e3e;
        --gold-3: #5a4824;
        --blood: #7a1a1f;
        --blood-2: #a8262c;
        --blood-ink: #d0595e;
        --verd: #5fc6b0;
        --verd-2: #2f7f71;
