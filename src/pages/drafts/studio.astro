    <script>
      // Slowly spin the wireframe mesh
      const RINGS: [number, number][] = [
        [40, 70], [110, 52], [180, 40], [250, 36], [320, 42], [390, 60], [460, 92], [520, 140], [574, 200],
      ];
      const SEG = 10;
      const f = (p: number[]) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
      function mesh(t: number) {
        const pts = RINGS.map(([y, r], i) =>
          Array.from({ length: SEG }, (_, j) => {
            const a = (j / SEG) * Math.PI * 2 + t + i * 0.35;
            return [1170 + r * Math.cos(a), y + r * 0.22 * Math.sin(a)];
          }),
        );
        let d = '';
        pts.forEach((ring, i) =>
          ring.forEach((p, j) => {
            d += `M${f(p)}L${f(ring[(j + 1) % SEG])}`;
            if (i < pts.length - 1) d += `M${f(p)}L${f(pts[i + 1][j])}M${f(p)}L${f(pts[i + 1][(j + 1) % SEG])}`;
          }),
        );
        return d;
      }
      const el = document.getElementById('mesh');
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (el && !still) {
        let visible = true;
        new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(el);
        const tick = (ms: number) => {
          if (visible) el.setAttribute('d', mesh(ms / 6000));
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      // Calendar shows today's date for whoever's looking
      const d = new Date();
      const m = document.getElementById('cal-month');
      const day = document.getElementById('cal-day');
      if (m) m.textContent = d.toLocaleString('en', { month: 'short' }).toUpperCase();
      if (day) day.textContent = String(d.getDate());
    </script>

