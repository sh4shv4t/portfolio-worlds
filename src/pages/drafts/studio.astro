---
import { url as baseUrl } from '../../site';
// DRAFT: Studio Stage. A messy workbench on a lit set; every prop is a project.
const O = '#1b100a'; // outline ink, gives the cel-shaded toy look

// Perspective grid on the floor (vanishing point at the horizon centre)
const VX = 800;
const verticals: number[] = [];
for (let x = -1800; x <= 3400; x += 130) verticals.push(x);
const horizontals = [572, 590, 614, 646, 690, 750, 830];

// Wireframe "unfinished mesh" in the back: a twisted lathe, animated in JS
const RINGS: [number, number][] = [
  [40, 70], [110, 52], [180, 40], [250, 36], [320, 42], [390, 60], [460, 92], [520, 140], [574, 200],
];
const SEG = 10;
function mesh(t: number) {
  const cx = 1170;
  const pts = RINGS.map(([y, r], i) =>
    Array.from({ length: SEG }, (_, j) => {
      const a = (j / SEG) * Math.PI * 2 + t + i * 0.35;
      return [cx + r * Math.cos(a), y + r * 0.22 * Math.sin(a)];
    }),
  );
  const f = (p: number[]) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
  let d = '';
  pts.forEach((ring, i) =>
    ring.forEach((p, j) => {
      d += `M${f(p)}L${f(ring[(j + 1) % SEG])}`;
      if (i < pts.length - 1) d += `M${f(p)}L${f(pts[i + 1][j])}M${f(p)}L${f(pts[i + 1][(j + 1) % SEG])}`;
    }),
  );
  return d;
}
const meshPath = mesh(0);

const now = new Date();
const month = now.toLocaleString('en', { month: 'short' }).toUpperCase();
const day = now.getDate();

const bench = [
  { href: baseUrl('/projects/project-z'), label: 'the CRT', title: 'Project Z', text: 'A self-hostable platform for agents that get better over time. Run, see, learn.' },
  { href: baseUrl('/projects/tracebank'), label: 'the cassette', title: 'tracebank', text: 'Collects consented, long-horizon coding agent traces, scrubbed on your own machine.' },
  { href: baseUrl('/projects/errand'), label: 'the drone', title: 'Errand', text: 'Send your model on fewer errands. Big models hand off tasks to cheaper specialists.' },
  { href: baseUrl('/projects/reminders'), label: 'the calendar', title: 'Reminders', text: "A small Windows app so birthdays, events and tasks don't slip through." },
  { href: baseUrl('/research'), label: 'the notebook', title: 'Research', text: 'Hidden overrides in reasoning models, LLM sameness and a malloc question.' },
  { href: baseUrl('/oss'), label: 'the laptop + d20', title: 'Open source & Kaggle', text: 'Merged PRs in Kubeflow and Cortex, plus Name That LLM on Kaggle.' },
  { href: baseUrl('/writing'), label: 'the zines', title: 'Writing', text: 'Stuff I write on Medium.' },
];

const motes = Array.from({ length: 16 }, (_, i) => ({
  x: 900 + ((i * 97) % 480),
  y: 120 + ((i * 53) % 380),
  r: 1.5 + (i % 3),
  d: 9 + (i % 5) * 2,
  delay: -(i * 1.3),
}));
