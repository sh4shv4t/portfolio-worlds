      }
      .panel p { margin: 0 0 12px; font-size: 0.95rem; color: #d7d0f5; }
      .p-acts { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
      .p-go, .p-alt {
        font: 400 0.78rem/1 var(--pix); text-decoration: none; cursor: pointer;
        padding: 9px 12px; border-radius: 3px;
      }
      .p-go { color: #07051a; background: var(--c); border: 1px solid var(--c); box-shadow: 0 0 12px color-mix(in srgb, var(--c) 60%, transparent); }
      .p-go:hover { filter: brightness(1.15); }
      .p-alt { color: var(--ink); border: 1px solid rgba(236, 230, 255, 0.35); background: transparent; }
      .p-alt:hover { border-color: #fff; }
      .p-keys { font-size: 0.75rem; color: var(--muted); }

      /* ---------- touch pad + credits ---------- */
      .pad { display: none; }
      @media (hover: none), (pointer: coarse), (max-width: 760px) {
        .pad {
          display: block; position: fixed; inset: auto 0 0 0; z-index: 20; height: 0;
        }
        .pad-btn {
          position: fixed; bottom: max(14px, env(safe-area-inset-bottom)); width: 58px; height: 58px;
          font: 400 1.3rem/1 var(--pix); color: #e8fbff; cursor: pointer;
          border: 2px solid rgba(34, 240, 255, 0.7); border-radius: 8px;
          background: rgba(7, 5, 26, 0.6);
          box-shadow: 0 0 12px rgba(34, 240, 255, 0.3);
          touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
        }
        .pad-btn:active { background: rgba(34, 240, 255, 0.25); }
        #padL { left: 16px; }
        #padR { right: 16px; }
      }
      .credits {
        position: fixed; z-index: 20; left: 50%; bottom: 6px; transform: translateX(-50%);
        margin: 0; white-space: nowrap; pointer-events: none;
        font: 400 0.6rem/1 var(--pix); color: rgba(236, 230, 255, 0.5);
      }

      /* ---------- directory as a slide-out (JS) ---------- */
      html.js .dir:not(.open):not(:focus-within) {
        position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
        clip: rect(0 0 0 0); white-space: nowrap; border: 0;
      }
      html.js .dir.open, html.js .dir:focus-within {
        position: fixed; z-index: 80; top: 0; right: 0; bottom: 0; width: min(420px, 100vw);
        overflow-y: auto; overscroll-behavior: contain;
        background: rgba(7, 5, 26, 0.96); border-left: 1px solid rgba(255, 43, 214, 0.5);
        box-shadow: -10px 0 40px rgba(0, 0, 0, 0.6);
      }
      html.js .dir-in { padding: 20px 20px 40px; }
      html.js .dir h1 { font-size: 1.6rem; }
      .dir-close {
        float: right; font: 400 0.7rem/1 var(--pix); color: var(--ink); cursor: pointer;
        padding: 0.5rem 0.6rem; border-radius: 3px; border: 1px solid rgba(34, 240, 255, 0.55); background: transparent;
      }

      /* ---------- small screens ---------- */
      @media (max-width: 600px) {
        .hud { padding-left: 12px; padding-right: 12px; }
        .hud-hint { display: none; }
        .hud-row .hud-btn:first-of-type { margin-left: auto; }
        .map { --pad: 12px; height: 18px; }
        .mark span { display: none; }
        .panel { left: 16px; right: 16px; width: auto; top: 86px; padding: 12px 14px; }
        .panel h2 { font-size: 1.3rem; }
        .panel p { font-size: 0.88rem; margin-bottom: 10px; }
        .credits { width: calc(100% - 172px); white-space: normal; text-align: center; line-height: 1.4; bottom: max(10px, env(safe-area-inset-bottom)); }
      }
      @media (max-height: 520px) {
        .panel { top: 70px; max-width: 320px; padding: 10px 12px; }
        .panel p { font-size: 0.82rem; margin-bottom: 8px; }
        .panel h2 { font-size: 1.2rem; }
        .map { height: 18px; }
        .mark span { display: none; }
      }

      /* ---------- reduced motion: no rain, no flicker, the camera jumps ---------- */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        .lite { opacity: 1; filter: none; }
        .t-ticker span { padding-left: 0; }
      }
    </style>
  </body>
</html>
