---
// Draft: Neon Alley. A side-scrolling night alley you walk through, like a tiny 2D game level.
// Standalone page on purpose (no Base layout) so the whole look lives in this file.
// Pixel art: "Warped City" by ansimuz (CC0). UI sounds: Kenney (CC0).
import { site, url } from '../../site';

const LW = 2720; // level width in art pixels

const bio =
  'I build stuff around LLM agents: how they run, how you figure out where they went wrong and how they get better over time. On the research side I poke at the insides of reasoning models, and when I can I contribute to open source AI infra.';

const shops = [
  {
    id: 'errand', x: 470, name: 'Errand', jp: '配達', jpMeaning: 'delivery', status: 'building', c: '#ff2bd6', icon: 'boxes',
    desc: 'Send your model on fewer errands. A marketplace where big models hand off tasks to cheaper specialist models.',
    href: url('/projects/errand'),
  },
  {
    id: 'tracebank', x: 730, name: 'tracebank', jp: '記録', jpMeaning: 'record', status: 'building', c: '#22f0ff', icon: 'rack',
    desc: 'A plugin that collects consented, long-horizon coding agent traces, scrubbed on your own machine.',
    href: url('/projects/tracebank'),
  },
  {
    id: 'projectz', x: 990, name: 'Project Z', jp: '学習', jpMeaning: 'learning', status: 'building', c: '#b06bff', icon: 'screen',
    desc: 'A self-hostable platform for agents that get better over time. Run, see, learn.',
    href: url('/projects/project-z'),
  },
  {
    id: 'reminders', x: 1250, name: 'Reminders', jp: '予定', jpMeaning: 'plans', status: 'shipped', c: '#ff9a3c', icon: 'calendar',
    desc: "A small Windows app so birthdays, events and tasks don't slip through.",
    href: url('/projects/reminders'),
  },
];

const cans = [
  { id: 'can1', x: 1556, n: 1, title: "Overrides the chain of thought doesn't show", status: 'in progress', tag: 'CoT', c: '#ff2bd6', led: '#3cff9a' },
  { id: 'can2', x: 1590, n: 2, title: 'Why do LLMs all sound the same?', status: 'early', tag: 'SAME?', c: '#22f0ff', led: '#ffbf3c' },
  { id: 'can3', x: 1624, n: 3, title: 'What if malloc filled holes from the top?', status: 'writing up', tag: 'malloc', c: '#ff9a3c', led: '#3cff9a' },
];

const repos = ['kubeflow/pipelines', 'cortexproject/cortex', 'kubeflow/website'];

// Everything the game loop needs. Positions are in art pixels.
const items = [
  {
    id: 'start', kind: 'start', x: 185, hw: 80, rect: [60, 310, 28, 204], c: '#ff2bd6', map: 'Start',
    name: "Hey, I'm Shashvat.", kick: 'Shashvat Singh', desc: bio, verb: 'WALK IN',
    extra: [
      { label: 'GitHub', href: site.links.github, ext: true },
      { label: 'Medium', href: site.links.medium, ext: true },
    ],
  },
  ...shops.map((s) => ({
    id: s.id, kind: 'shop', x: s.x, hw: 62, rect: [s.x - 70, s.x + 74, 86, 204], c: s.c, map: s.name,
    name: s.name, jp: s.jp, status: s.status, desc: s.desc, href: s.href, verb: 'ENTER',
  })),
  ...cans.map((k) => ({
    id: k.id, kind: 'can', x: k.x, hw: 17, rect: [k.x - 16, k.x + 16, 102, 178], c: k.c, map: k.n === 2 ? 'Drinks' : '',
    name: k.title, n: k.n, status: k.status, tag: k.tag, led: k.led, href: url('/research'), verb: 'BUY',
    desc: 'Served cold from the research machine. Grab one to read about it.',
  })),
  {
    id: 'writing', kind: 'spot', x: 1880, hw: 66, rect: [1812, 1948, 92, 204], c: '#ff2bd6', map: 'Writing',
    name: 'Writing', jp: '執筆', desc: 'Posts and write-ups, mostly on Medium.', href: url('/writing'), verb: 'READ',
    extra: [{ label: 'Medium', href: site.links.medium, ext: true }],
  },
  {
    id: 'oss', kind: 'spot', x: 2150, hw: 66, rect: [2083, 2217, 106, 180], c: '#22f0ff', map: 'OSS',
    name: 'Open source', jp: 'オープンソース',
    desc: 'Merged PRs in kubeflow/pipelines, cortexproject/cortex and kubeflow/website. Also on Kaggle’s Name That LLM right now.',
    href: url('/oss'), verb: 'ENTER',
    extra: [{ label: 'GitHub', href: site.links.github, ext: true }],
  },
  {
    id: 'github', kind: 'spot', x: 2400, hw: 58, rect: [2346, 2454, 98, 204], c: '#22f0ff', map: 'Exit',
    name: 'GitHub', kick: 'End of the alley', desc: 'github.com/sh4shv4t', href: site.links.github, ext: true, verb: 'VISIT',
  },
  {
    id: 'medium', kind: 'spot', x: 2540, hw: 58, rect: [2486, 2594, 98, 204], c: '#ff2bd6', map: '',
    name: 'Medium', kick: 'End of the alley', desc: 'medium.com/@shashvat.k.singh.16', href: site.links.medium, ext: true, verb: 'VISIT',
  },
];

const marks = items.filter((i) => i.map);
const data = { base: import.meta.env.BASE_URL.replace(/\/$/, ''), levelW: LW, items, shops, cans };
const S = (x: number, y: number, extra = '') => `--x:${x};--y:${y};${extra}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Shashvat Singh / Neon Alley</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#07051a" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Noto+Sans+JP:wght@500;900&family=Orbitron:wght@600;800;900&family=Silkscreen&family=Tilt+Neon&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <!-- ================= THE LEVEL ================= -->
    <div id="stage" class="stage" aria-hidden="true">
      <canvas id="back" class="cv"></canvas>

      <!-- Neon signs live in the DOM so the text stays crisp. Positions are art pixels times --u. -->
      <div id="signs" class="world">
        <!-- title moment -->
        <div class="w t-name lite" data-for="start" style={S(185, 31)}>Shashvat Singh</div>
        <div class="w t-hey lite" data-for="start" style={S(185, 75)}>Hey, I'm Shashvat.</div>
        <div class="w t-ticker lite" data-for="start" style={S(110, 117)}><span>{bio}&nbsp;&nbsp;&nbsp;&nbsp;Walk right to look around.&nbsp;&nbsp;&nbsp;&nbsp;</span></div>
        <div class="w t-hint" id="walkhint" style={S(300, 166)}><b>&#9654;</b> this way</div>

        <!-- shopfronts -->
        {shops.map((s) => (
          <>
            <div class="w s-sign lite" data-for={s.id} style={S(s.x, 104, `--c:${s.c}`)}>{s.name}</div>
            <div class="w s-kanji lite" data-for={s.id} lang="ja" title={s.jpMeaning} style={S(s.x + 59, 90, `--c:${s.c}`)}>{s.jp}</div>
            <div class={`w s-badge lite ${s.status}`} data-for={s.id} lang="ja" style={S(s.x - 46, 143)}>{s.status === 'shipped' ? '営業中' : '準備中'}</div>
          </>
        ))}

        <!-- research vending machine -->
        <div class="w v-head lite" data-for="can2" style={S(1536, 84)}><span lang="ja">自動販売機</span></div>
        {cans.map((k) => (
          <div class="w v-lab lite" data-for={k.id} style={S(k.x, 132, `--c:${k.c};--led:${k.led}`)}>
            <span class="v-tag">{k.tag}</span>
            <span class="v-title">{k.title}</span>
            <span class="v-st"><i></i>{k.status}</span>
          </div>
        ))}

        <!-- writing newsstand -->
        <div class="w n-sign lite" data-for="writing" style={S(1880, 94)}>
          <span class="n-jp" lang="ja">執筆</span><span class="n-en">Writing</span>
        </div>
        <div class="w n-medium lite" data-for="writing" style={S(1920, 140)}>Medium</div>

        <!-- OSS noticeboard -->
        <div class="w o-head lite" data-for="oss" style={S(2086, 111)}><span lang="ja">オープンソース</span><b>OSS</b></div>
        {repos.map((r, i) => (
          <div class="w o-slip lite" data-for="oss" style={S(i % 2 ? 2152 : 2091, i < 2 ? 128 : 146)}><b>merged PRs</b>{r}</div>
        ))}
        <div class="w o-slip kag lite" data-for="oss" style={S(2152, 146)}><b>ongoing</b>Kaggle: Name That LLM</div>

        <!-- end of the alley -->
        <div class="w e-sign lite" data-for="github" style={S(2400, 108, '--c:#22f0ff')}>GitHub</div>
        <div class="w e-sign lite" data-for="medium" style={S(2540, 108, '--c:#ff2bd6')}>Medium</div>
        <div class="w e-bye lite" data-for="medium" lang="ja" style={S(2670, 52)}>またね</div>
        <div class="w e-thanks lite" data-for="medium" style={S(2670, 152)}>Thanks for walking the alley.</div>
      </div>

      <canvas id="front" class="cv"></canvas>

      <div id="uiw" class="world">
        <div id="bubble" class="bubble"><span class="k">[&uarr;] / [E] / tap:</span> <b id="verb">ENTER</b></div>
      </div>
      <div class="scan"></div>
    </div>

    <!-- ================= HUD ================= -->
    <header class="hud" id="hud">
      <div class="hud-row">
        <a class="draft-tag" href={url('/drafts')}>Draft: Neon Alley</a>
        <span class="hud-hint"><span class="kb-only">&larr; &rarr; to walk, Shift to run</span><span class="touch-only">Swipe or &#9664; &#9654; to walk</span></span>
        <button class="hud-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="dir">Menu</button>
        <button class="hud-btn" id="sndBtn" type="button" aria-pressed="false">SND <b>OFF</b></button>
      </div>
      <nav class="map" id="map" aria-label="Alley map">
        <span class="map-track" aria-hidden="true"></span>
        {marks.map((m) => (
          <button class="mark" type="button" data-go={m.id} style={`--p:${(m.x / LW).toFixed(4)};--c:${m.c}`} aria-label={`Walk to ${m.map}`} title={m.map}>
            <i aria-hidden="true"></i><span>{m.map}</span>
          </button>
        ))}
        <span class="marker" id="marker" aria-hidden="true"></span>
      </nav>
    </header>

    <aside class="panel" id="panel" aria-live="polite"></aside>

    <div class="pad" aria-label="Walk controls">
      <button class="pad-btn" id="padL" type="button" aria-label="Walk left">&#9664;</button>
      <button class="pad-btn" id="padR" type="button" aria-label="Walk right">&#9654;</button>
    </div>
    <p class="credits">City pixel art by ansimuz. UI sounds by Kenney.</p>

    <!-- ================= DIRECTORY: real links, the no-JS page and the slide-out menu ================= -->
    <main id="dir" class="dir" tabindex="-1">
      <div class="dir-in">
        <button class="dir-close" id="dirClose" type="button">Close</button>
        <p class="dir-kick" lang="ja">夜の路地</p>
        <h1>Shashvat Singh</h1>
        <p class="dir-hey">Hey, I'm Shashvat.</p>
        <p>{bio}</p>

        <h2><span lang="ja">路地裏</span> Shops (projects)</h2>
        <ul>
          {shops.map((s) => (
            <li>
              <a href={s.href} data-go={s.id}>{s.name}</a>
              <span class="dir-meta"><span lang="ja">{s.jp}</span> / <span lang="ja">{s.status === 'shipped' ? '営業中' : '準備中'}</span> {s.status}</span>
              <span class="dir-desc">{s.desc}</span>
            </li>
          ))}
        </ul>

        <h2><span lang="ja">自動販売機</span> Research vending machine</h2>
        <ul>
          {cans.map((k) => (
            <li>
              <a href={url('/research')} data-go={k.id}>{k.title}</a>
              <span class="dir-meta">{k.status}</span>
            </li>
          ))}
        </ul>

        <h2>Also down the alley</h2>
        <ul>
          <li><a href={url('/writing')} data-go="writing">Writing</a> <span class="dir-desc">Posts and write-ups.</span> <a href={site.links.medium} target="_blank" rel="me noopener" data-go="writing">Medium</a></li>
          <li>
            <a href={url('/oss')} data-go="oss">Open source</a>
            <span class="dir-desc">Merged PRs in kubeflow/pipelines, cortexproject/cortex and kubeflow/website. Kaggle: Name That LLM (ongoing).</span>
          </li>
          <li><a href={site.links.github} target="_blank" rel="me noopener" data-go="github">GitHub</a></li>
          <li><a href={site.links.medium} target="_blank" rel="me noopener" data-go="medium">Medium</a></li>
          <li><a href={url('/drafts')}>All drafts</a></li>
        </ul>
        <p class="dir-credits">City pixel art by ansimuz (Warped City, CC0). UI sounds by Kenney (CC0).</p>
      </div>
    </main>

    <script is:inline type="application/json" id="alley-data" set:html={JSON.stringify(data)}></script>

    <script is:inline>
      (function () {
        'use strict';
        var D = JSON.parse(document.getElementById('alley-data').textContent);
        var $ = function (s) { return document.querySelector(s); };
        var HW = 240, G = 200, FEET = 207, CURB = 212, LW = D.levelW, PMIN = 26, PMAX = LW - 112;
        var WALK = 64, RUN = 155;
        var items = D.items;
        var byId = {};
        items.forEach(function (it) { byId[it.id] = it; it.lit = false; it.els = []; });
        var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
        var RM = mq.matches;

        var stage = $('#stage'), back = $('#back'), front = $('#front'), signs = $('#signs'), uiw = $('#uiw');
        var bubble = $('#bubble'), verbEl = $('#verb'), panel = $('#panel'), marker = $('#marker');
        var bc = back.getContext('2d'), fc = front.getContext('2d');

        document.querySelectorAll('#signs [data-for]').forEach(function (el) {
          var it = byId[el.getAttribute('data-for')];
          if (it) it.els.push(el);
        });

        // ---------- state ----------
        var scale = 3, u = 3, vw = 480, vh = 287, top0 = 47;
        var P = { x: 120, vx: 0, face: 1, phase: 0 };
        var cam = 0, camR = -99999, lastCamR = 0, auto = null, autoRun = false;
        var keyL = false, keyR = false, shift = false, hold = 0, holdT = 0;
        var active = null, busy = false, T = 0, first = true, hinted = false;
        var flash = null, drop = null;

        try {
          var saved = JSON.parse(sessionStorage.getItem('alley-pos') || 'null');
          if (saved && Date.now() - saved.t < 36e5) { P.x = clamp(saved.x); P.face = saved.f || 1; }
        } catch (e) {}
        // deep link straight to a spot, e.g. /drafts/neon-alley#can2 or #oss
        var hashId = decodeURIComponent(location.hash.slice(1));
        if (byId[hashId]) P.x = byId[hashId].x;
        window.addEventListener('hashchange', function () {
          var it = byId[decodeURIComponent(location.hash.slice(1))];
          if (it) walkTo(it.x, true);
        });

        function clamp(x) { return Math.max(PMIN, Math.min(PMAX, x)); }
        function save() {
          try { sessionStorage.setItem('alley-pos', JSON.stringify({ x: Math.round(P.x), f: P.face, t: Date.now() })); } catch (e) {}
        }

        // ---------- sound (off by default) ----------
        var sndOn = false, sndCache = {};
        try { sndOn = localStorage.getItem('alley-snd') === '1'; } catch (e) {}
        var sndBtn = $('#sndBtn');
        function paintSnd() {
          sndBtn.setAttribute('aria-pressed', sndOn ? 'true' : 'false');
          sndBtn.querySelector('b').textContent = sndOn ? 'ON' : 'OFF';
        }
        function play(n, vol) {
          if (!sndOn) return;
          try {
            var a = sndCache[n] || (sndCache[n] = new Audio(D.base + '/assets/sfx/' + n + '.mp3'));
            var c = a.cloneNode();
            c.volume = vol == null ? 0.45 : vol;
            var p = c.play();
            if (p && p.catch) p.catch(function () {});
          } catch (e) {}
        }
        paintSnd();
        sndBtn.addEventListener('click', function () {
          sndOn = !sndOn;
          try { localStorage.setItem('alley-snd', sndOn ? '1' : '0'); } catch (e) {}
          paintSnd();
          play('toggle', 0.5);
        });

        // ---------- images ----------
        var A = D.base + '/assets/alley/', C = D.base + '/assets/city/';
        var srcs = {
          tiles: A + 'tileset.png', player: A + 'player.png', bigb: A + 'banner-big.png', neonb: A + 'banner-neon.png',
          scrollb: A + 'banner-scroll.png', sideb: A + 'banner-side.png', sushib: A + 'banner-sushi.png', face: A + 'monitor-face.png',
          cb1: A + 'control-box-1.png', cb2: A + 'control-box-2.png', cb3: A + 'control-box-3.png', ant: A + 'antenna.png',
          hotel: A + 'hotel-sign.png', open: A + 'banner-open.png', arrow: A + 'banner-arrow.png', small: A + 'banner-small.png',
          banners: A + 'banners.png', sky: C + 'sky.png', far: C + 'buildings-far.png', near: C + 'buildings-near.png'
        };
        var IM = {};
        function load(k) {
          return new Promise(function (res) {
            var i = new Image();
            i.onload = function () { IM[k] = i; res(); };
            i.onerror = function () { res(); };
            i.src = srcs[k];
          });
        }

        // ---------- seeded rng so the alley looks the same every visit ----------
        var seed = 2077;
        function rnd() {
          seed = (seed + 0x6d2b79f5) | 0;
          var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        }

        // tileset regions [sx, sy, w, h]
        var TL = {
          panelA: [16, 16, 16, 48], win: [48, 16, 48, 64], shut: [224, 16, 48, 64], pillar: [288, 16, 32, 64],
          ladder: [32, 96, 16, 32], pipe: [64, 96, 16, 48], pbox: [64, 160, 16, 32], mach: [160, 96, 48, 32],
          ac: [176, 144, 32, 32], half: [224, 96, 48, 64], grate: [288, 96, 16, 32], mon: [320, 96, 16, 32],
          pbox2: [352, 96, 16, 32], glow: [224, 176, 48, 64], canopy: [104, 176, 48, 16]
        };

        // ---------- static world: drawn once into a long offscreen canvas ----------
        var main, mctx, nearT, farT;
        var lamps = [], lanterns = [], vents = [], anims = [], flick = [];

        function R(x, y, w, h, col) { mctx.fillStyle = col; mctx.fillRect(x, y, w, h); }
        function tile(k, x, y) {
          if (!IM.tiles) return;
          var t = TL[k];
          mctx.drawImage(IM.tiles, t[0], t[1], t[2], t[3], x, y, t[2], t[3]);
        }
        function img(k, x, y) { if (IM[k]) mctx.drawImage(IM[k], x, y); }

        function tint(im, col, a) {
          if (!im) return null;
          var c = document.createElement('canvas');
          c.width = im.width; c.height = im.height;
          var x = c.getContext('2d');
          x.drawImage(im, 0, 0);
          x.globalCompositeOperation = 'source-atop';
          x.globalAlpha = a;
          x.fillStyle = col;
          x.fillRect(0, 0, c.width, c.height);
          return c;
        }

        var SEG = [
          [0, 30, 60], [30, 340, 112], [340, 400, 84], [400, 540, 96], [540, 660, 118], [660, 800, 104], [800, 920, 70],
          [920, 1060, 92], [1060, 1180, 114], [1180, 1320, 100], [1320, 1520, 88], [1520, 1660, 126], [1660, 1810, 104],
          [1810, 1950, 116], [1950, 2080, 106], [2080, 2220, 96], [2220, 2340, 78], [2340, 2620, 108], [2620, 2720, 34]
        ];
        var WALLC = ['#151031', '#120f2a', '#171236', '#100d26'];
        var WINC = ['#ffb35c', '#ffb35c', '#ffd08a', '#5ef6ff', '#ff6fe0'];

        function wire(x0, y0, x1, y1, sag, col) {
          var n = Math.max(2, Math.abs(x1 - x0));
          for (var i = 0; i <= n; i++) {
            var t = i / n;
            var x = Math.round(x0 + (x1 - x0) * t);
            var y = Math.round(y0 + (y1 - y0) * t + Math.sin(Math.PI * t) * sag);
            R(x, y, 1, 1, col);
          }
        }
        function wireY(x0, y0, x1, y1, sag, t) { return y0 + (y1 - y0) * t + Math.sin(Math.PI * t) * sag; }

        function buildMain() {
          main = document.createElement('canvas');
          main.width = LW; main.height = HW;
          mctx = main.getContext('2d');
          seed = 2077;

          // building walls
          SEG.forEach(function (s, si) {
            var x0 = s[0], x1 = s[1], top = s[2], w = x1 - x0;
            R(x0, top, w, G - top, WALLC[si % WALLC.length]);
            R(x0, top, w, 2, '#2c2556'); R(x0, top, w, 1, '#4b3f8a'); R(x0, top + 2, w, 1, '#0a0818');
            R(x0, top, 1, G - top, '#0a0818');
            // faint brick courses on the lower wall
            for (var by = G - 92; by < G; by += 6) R(x0, by, w, 1, 'rgba(0,0,0,0.18)');
            // windows on the upper floors
            for (var wy = top + 8; wy + 6 < G - 98; wy += 11) {
              for (var wx = x0 + 6; wx < x1 - 9; wx += 9) {
                var lit = rnd() < 0.3;
                var col = lit ? WINC[Math.floor(rnd() * WINC.length)] : '#1d1740';
                R(wx, wy, 4, 6, col);
                if (lit) { R(wx, wy + 5, 4, 1, 'rgba(0,0,0,0.35)'); if (rnd() < 0.12) flick.push([wx, wy, rnd() * 10]); }
              }
            }
            if (top < 96) R(x0, G - 97, w, 2, '#241e48');
            // rooftop clutter
            if (rnd() < 0.7 && w > 70) {
              var tx = x0 + 10 + Math.floor(rnd() * (w - 40));
              R(tx, top - 9, 14, 8, '#1a1534'); R(tx, top - 9, 14, 1, '#2f2860'); R(tx + 2, top - 1, 2, 1, '#0a0818'); R(tx + 10, top - 1, 2, 1, '#0a0818');
            }
          });
          img('ant', 560, 118 - 96);
          img('ant', 1700, 104 - 96);
          img('ant', 2250, 78 - 96);
          img('hotel', 1978, 106 - 35);
          img('cb3', 860, 70 - 30);

          // high cables across the alley with paper lanterns
          var W1 = [[340, 92, 400, 88], [540, 124, 660, 110], [800, 80, 920, 98], [1060, 120, 1180, 106], [1320, 96, 1520, 96],
